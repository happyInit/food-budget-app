{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RuntimeCommon",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams",
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Retrieve",
        "bedrock:RetrieveAndGenerate",
        "bedrock:ApplyGuardrail",
        "ecr:GetAuthorizationToken",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ec2:CreateNetworkInterface",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DeleteNetworkInterface",
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords",
        "cloudwatch:PutMetricData",
        "sns:Publish",
        "cloudwatch:PutMetricAlarm"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RuntimeOwnResources",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "sqs:*",
        "lambda:InvokeFunction",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:s3:::mp-ai-*",
        "arn:aws:s3:::mp-ai-*/*",
        "arn:aws:sqs:*:${ACCOUNT_ID}:mp-ai-*",
        "arn:aws:lambda:*:${ACCOUNT_ID}:function:mp-ai-*",
        "arn:aws:secretsmanager:*:${ACCOUNT_ID}:secret:mp-ai/*"
      ]
    },
    {
      "Sid": "CeilingHardDeny",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "sts:AssumeRole",
        "organizations:*",
        "account:*",
        "eks:*",
        "elasticloadbalancing:*",
        "wafv2:*",
        "rds:*",
        "elasticache:*",
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ssm:StartSession"
      ],
      "Resource": "*"
    }
  ]
}