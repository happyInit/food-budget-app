# {{ ansible_managed }}
# GitHub Actions self-hosted runner (PAT로 자동 등록)
services:
  github-runner:
    image: myoung34/github-runner:latest
    container_name: github-runner
    restart: unless-stopped
    environment:
      ACCESS_TOKEN: "{{ github_runner_pat }}"
      REPO_URL: "https://github.com/{{ github_repo }}"
      RUNNER_NAME: "{{ runner_name }}"
      RUNNER_SCOPE: "repo"
      LABELS: "{{ runner_labels }}"
      RUNNER_WORKDIR: "/tmp/runner/work"
      # ⚠️ 이 이미지의 부울 옵션은 "값"이 아니라 "정의 여부"로 판정된다
      #    (entrypoint.sh: `if [ -n "${VAR}" ]` → config.sh 플래그 추가).
      #    즉 EPHEMERAL: "false" 는 ephemeral 을 끄는 게 아니라 켠다.
      #    끄려면 변수를 아예 정의하지 말 것. 아래 DISABLE_AUTO_UPDATE 도 같은 방식이라
      #    값과 무관하게 "정의되어 있으면 적용"이다.
      DISABLE_AUTO_UPDATE: "true"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock   # 빌드 시 호스트 docker 사용
      - runner_work:/tmp/runner
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: "1.0"

volumes:
  runner_work:
