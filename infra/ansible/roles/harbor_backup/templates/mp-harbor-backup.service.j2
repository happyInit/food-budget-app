# Managed by Ansible (roles/harbor_backup)
[Unit]
Description=mp Harbor backup (DB·secret·config·certs) → S3
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile={{ harbor_backup_env_file }}
ExecStart={{ harbor_backup_script }}
TimeoutStartSec=1200
