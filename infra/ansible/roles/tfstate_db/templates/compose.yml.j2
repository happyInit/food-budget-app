# {{ ansible_managed }}
# fb-data 공유 PostgreSQL 인스턴스
#   - DB terraform_state : Terraform remote backend "pg" (인프라 정본, 무손상 유지)
#   - DB foodbudget      : 앱 OLTP (SQLAlchemy+Alembic) — DB만 분리, 같은 인스턴스 공유
#   앱 DB/롤 생성은 tasks/main.yml 에서 멱등 처리 (여기선 엔진만 기동)
services:
  tfstate-db:
    image: postgres:16-alpine
    container_name: tfstate-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: terraform_state
      POSTGRES_USER: terraform
      POSTGRES_PASSWORD: {{ tfstate_db_password }}
    ports:
      - "5432:5432"
    volumes:
      - tfstate_pg:/var/lib/postgresql/data
    deploy:
      resources:
        limits:
          memory: 1536M      # 512M→1.5G : 앱 OLTP buffer/cache 몫 추가
          cpus: "1.0"        # 0.5→1.0
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U terraform -d terraform_state"]
      interval: 10s
      timeout: 5s
      retries: 5

  # PostgreSQL 메트릭 → Prometheus (fb-monitoring 이 :9187 스크레이프)
  postgres-exporter:
    image: quay.io/prometheuscommunity/postgres-exporter:v0.16.0
    container_name: postgres-exporter
    restart: unless-stopped
    environment:
      DATA_SOURCE_NAME: "postgresql://terraform:{{ tfstate_db_password }}@tfstate-db:5432/postgres?sslmode=disable"
    ports:
      - "9187:9187"
    depends_on:
      tfstate-db:
        condition: service_healthy
    deploy:
      resources:
        limits:
          memory: 128M
          cpus: "0.2"

volumes:
  tfstate_pg:
