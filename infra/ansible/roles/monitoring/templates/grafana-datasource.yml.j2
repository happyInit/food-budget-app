# {{ ansible_managed }}
# Loki<->Tempo 상호 링크는 설정만 준비된 상태.
# 실제로 연결되려면 앱 JSON 로그에 trace_id 필드가 있어야 하고,
# OpenTelemetry service.name과 컨테이너명(container 라벨)이 같아야 함 — 계측 전까진 검증 불가.
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: true
  - name: Loki
    type: loki
    uid: loki
    access: proxy
    url: http://loki:3100
    editable: true
    jsonData:
      derivedFields:
        - datasourceUid: tempo
          matcherRegex: '"trace_id"\s*:\s*"([0-9a-fA-F]+)"'
          name: TraceID
          url: '$${__value.raw}'
  - name: Tempo
    type: tempo
    uid: tempo
    access: proxy
    url: http://tempo:3200
    editable: true
    jsonData:
      tracesToLogsV2:
        datasourceUid: loki
        tags:
          - key: service.name
            value: container
        filterByTraceID: false
        filterBySpanID: false
