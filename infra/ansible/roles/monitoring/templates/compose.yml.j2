# {{ ansible_managed }}
# 모니터링 스택 (LGTM) — fb-monitoring
services:
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    restart: unless-stopped
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./alert-rules.yml:/etc/prometheus/alert-rules.yml:ro
      - prometheus_data:/prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.retention.time={{ prometheus_retention }}
      - --web.enable-lifecycle
    ports:
      - "9090:9090"
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: "1.0"

  loki:
    image: grafana/loki:latest
    container_name: loki
    restart: unless-stopped
    command: ["-config.file=/etc/loki/loki-config.yaml"]
    volumes:
      - ./loki-config.yaml:/etc/loki/loki-config.yaml:ro
      - loki_data:/loki
    ports:
      - "3100:3100"
    deploy:
      resources:
        limits:
          memory: 768M
          cpus: "0.5"

  tempo:
    image: grafana/tempo:latest
    container_name: tempo
    restart: unless-stopped
    command: ["-config.file=/etc/tempo/tempo.yaml"]
    volumes:
      - ./tempo.yaml:/etc/tempo/tempo.yaml:ro
      - tempo_data:/var/tempo
    ports:
      - "3200:3200"   # query
      - "4317:4317"   # OTLP grpc (앱 트레이스 수신용)
      - "4318:4318"   # OTLP http
    deploy:
      resources:
        limits:
          # ⚠️ 768M 으로 되돌리지 말 것 — 2026-07-21 14:48 UTC 에 그 한도로 OOM 크래시루프가 났다.
          #    12~13초 간격 8회 kill, 매회 anon-rss 781,440kB(763MiB) 로 동일 = 재기동마다 같은
          #    지점에서 죽는 자력회복 불가 루프. 서버에서 2G 로 올려 수습한 뒤 레포 반영이
          #    누락돼 있었다(드리프트). 근본 완화는 아래 두 가지 — tempo.yaml 보존기간 +
          #    앱 OTEL 샘플링 0.1(deploy/app/docker-compose.yml). 상세 = docs/infra-status.md §7
          memory: 2G
          cpus: "0.5"

  alertmanager:
    image: prom/alertmanager:latest
    container_name: alertmanager
    restart: unless-stopped
    volumes:
      - ./alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - alertmanager_data:/alertmanager
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
    ports:
      - "9093:9093"
    deploy:
      resources:
        limits:
          memory: 128M
          cpus: "0.2"

  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    restart: unless-stopped
    depends_on: [prometheus, loki, tempo]
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana-provisioning:/etc/grafana/provisioning:ro
      - ./grafana-dashboards:/var/lib/grafana/dashboards:ro
      - ./certs:/etc/grafana/certs:ro
    environment:
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_SERVER_PROTOCOL=https
      - GF_SERVER_CERT_FILE=/etc/grafana/certs/grafana.crt
      - GF_SERVER_CERT_KEY=/etc/grafana/certs/grafana.key
    ports:
      - "3000:3000"
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: "0.5"

volumes:
  prometheus_data:
  loki_data:
  tempo_data:
  grafana_data:
  alertmanager_data:
