# {{ ansible_managed }}
# 알림 라벨 스키마: severity / service / owner / environment
# owner 매핑은 아직 5인 역할분담이 미정이라, 지금은 채널 하나로 몰고
# severity로만 나눈다. 역할분담 확정 후 owner별 채널로 세분화 예정.

global:
  resolve_timeout: 5m

route:
  receiver: slack-default
  group_by: ['alertname', 'service']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - severity = "critical"
      receiver: slack-critical
      repeat_interval: 1h

{% set slack_ready = slack_webhook_url is defined and slack_webhook_url and not slack_webhook_url.startswith('CHANGE_ME') %}
# slack_webhook_url 미설정 시 receiver는 이름만 존재하는 null receiver로
# 렌더링됨 — Alertmanager는 정상 기동하되 실제 전송은 안 됨(배포 실패 방지).
# secrets.yml에 진짜 웹훅을 채우면 다음 배포부터 자동으로 Slack 전송 활성화.
receivers:
  - name: slack-default
{% if slack_ready %}
    slack_configs:
      - api_url: '{{ slack_webhook_url }}'
        channel: '#monitoring'
        send_resolved: true
        title: '[{{ '{{' }} .Status | toUpper {{ '}}' }}] {{ '{{' }} .CommonLabels.alertname {{ '}}' }}'
        text: >-
          service: {{ '{{' }} .CommonLabels.service {{ '}}' }} /
          owner: {{ '{{' }} .CommonLabels.owner {{ '}}' }}
          {{ '{{' }} range .Alerts {{ '}}' }}
          - {{ '{{' }} .Annotations.summary {{ '}}' }}
          {{ '{{' }} end {{ '}}' }}
{% endif %}

  - name: slack-critical
{% if slack_ready %}
    slack_configs:
      - api_url: '{{ slack_webhook_url }}'
        channel: '#alerts-critical'
        send_resolved: true
        title: '[{{ '{{' }} .Status | toUpper {{ '}}' }}] {{ '{{' }} .CommonLabels.alertname {{ '}}' }}'
        text: >-
          service: {{ '{{' }} .CommonLabels.service {{ '}}' }} /
          owner: {{ '{{' }} .CommonLabels.owner {{ '}}' }}
          {{ '{{' }} range .Alerts {{ '}}' }}
          - {{ '{{' }} .Annotations.summary {{ '}}' }}
          {{ '{{' }} end {{ '}}' }}
{% endif %}

inhibit_rules:
  - source_matchers:
      - severity = "critical"
    target_matchers:
      - severity = "warning"
    equal: ['alertname', 'service']
