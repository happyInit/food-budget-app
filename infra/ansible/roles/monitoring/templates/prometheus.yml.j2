# {{ ansible_managed }}
global:
  scrape_interval: 30s
  evaluation_interval: 30s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']

rule_files:
  - /etc/prometheus/alert-rules.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
{% for h in groups['all'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:9100']
        labels: {instance: '{{ h }}'}
{% endfor %}

  - job_name: cadvisor
    static_configs:
{% for h in groups['all'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:8080']
        labels: {instance: '{{ h }}'}
{% endfor %}

  # 데이터 티어 exporters (fb-data)
  - job_name: postgres
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9187']
        labels: {instance: 'fb-data'}

  - job_name: redis
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9121']
        labels: {instance: 'fb-data'}

  - job_name: elasticsearch
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9114']
        labels: {instance: 'fb-data'}

  - job_name: kafka
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9308']
        labels: {instance: 'fb-data'}

  # Docker Compose 상주 데이터 파이프라인 컴포넌트 (fb-data)
  - job_name: pipeline-consumers
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9401']
        labels: {instance: 'fb-data', component: 'retail-refiner'}
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9402']
        labels: {instance: 'fb-data', component: 'deal-notifier'}
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9403']
        labels: {instance: 'fb-data', component: 'recipe-refiner'}
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9404']
        labels: {instance: 'fb-data', component: 'deal-pruner'}

  # 관측 스택 자체 (fb-monitoring, 같은 compose 네트워크라 컨테이너명 사용)
  - job_name: loki
    static_configs:
      - targets: ['loki:3100']

  - job_name: tempo
    static_configs:
      - targets: ['tempo:3200']

  - job_name: alertmanager
    static_configs:
      - targets: ['alertmanager:9093']

  # Alloy는 전 VM에 배포됨 (monitoring_agents role)
  - job_name: alloy
    static_configs:
{% for h in groups['all'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:12345']
        labels: {instance: '{{ h }}'}
{% endfor %}
