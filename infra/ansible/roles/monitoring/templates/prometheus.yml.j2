# {{ ansible_managed }}
global:
  scrape_interval: 30s
  evaluation_interval: 30s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']

rule_files:
  - /etc/prometheus/alert-rules.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
{% for h in groups['vms'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:9100']
        labels: {instance: '{{ h }}'}
{% endfor %}

  # 물리 하이퍼바이저 — VM 과 **별도 job** 으로 둔다. `node` 에 섞으면 VMDown 알람이
  # 물리 호스트를 "VM 다운"으로 보고하고, cadvisor/alloy job 은 .12 에 없는 포트를
  # 긁어 영구 up==0 이 된다. (그래서 위 세 job 은 groups['all'] 이 아니라 groups['vms'].)
  # ⚠️ 이 job 의 up==0 으로는 호스트 급사를 못 잡는다 — Prometheus 자신이 .12 위의
  #    VM 이라 호스트가 죽으면 같이 죽는다. 이 job 의 값은 **급사 전 온도 곡선**이다.
  - job_name: hypervisor
    static_configs:
{% for h in groups['hypervisor'] | default([]) %}
      - targets: ['{{ hostvars[h].ansible_host }}:9100']
        labels: {instance: '{{ h }}'}
{% endfor %}

  - job_name: cadvisor
    static_configs:
{% for h in groups['vms'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:8080']
        labels: {instance: '{{ h }}'}
{% endfor %}

  # 데이터 티어 exporters (fb-data)
  - job_name: postgres
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9187']
        labels: {instance: 'fb-data'}

  - job_name: redis
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9121']
        labels: {instance: 'fb-data'}

  - job_name: elasticsearch
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9114']
        labels: {instance: 'fb-data'}

  - job_name: kafka
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9308']
        labels: {instance: 'fb-data'}

  # Docker Compose 상주 데이터 파이프라인 컴포넌트 (fb-data)
  - job_name: pipeline-consumers
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9401']
        labels: {instance: 'fb-data', component: 'retail-refiner'}
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9402']
        labels: {instance: 'fb-data', component: 'deal-notifier'}
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9403']
        labels: {instance: 'fb-data', component: 'recipe-refiner'}
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9404']
        labels: {instance: 'fb-data', component: 'deal-pruner'}

  # ~~FastAPI RED 메트릭 (fb-app-ai nginx 가 내부 /metrics 를 중계)~~
  # → **제거 (2026-07-28, P1)**. 앱이 K8s 로 갔고 수집 주체가 바뀌었다:
  #     in-cluster Prometheus 가 ServiceMonitor(`mp-app-services`)로 파드를 직접 긁고
  #     → remoteWrite 로 여기 `.11` 에 밀어 넣는다(roles/k8s_observability).
  #   compose 시절의 nginx allowlist 우회(location 9개)는 그대로 소멸했다(object_spec §5.4).
  #
  # 🔴 **순서가 중요하다** — `PrometheusTargetDown` 은 `up == 0` 전역 규칙이라,
  #    이 잡을 남겨 둔 채 `.9` 를 정지하면 타깃 9개가 즉시 down 으로 잡혀 알람 폭풍이 된다.
  #    반드시 "잡 제거 → reload → VM 정지" 순서로.
  #
  # 대시보드(00-overview·01-service-detail)는 **`service` 라벨로만 필터**하고 remoteWrite 로
  # 오는 K8s 시계열도 같은 `service=<이름>` 을 갖기 때문에 **수정 없이 그대로 동작한다**(실측 확인).

  # 관측 스택 자체 (fb-monitoring, 같은 compose 네트워크라 컨테이너명 사용)
  - job_name: loki
    static_configs:
      - targets: ['loki:3100']

  - job_name: tempo
    static_configs:
      - targets: ['tempo:3200']

  - job_name: alertmanager
    static_configs:
      - targets: ['alertmanager:9093']

  # Alloy는 전 VM에 배포됨 (monitoring_agents role)
  - job_name: alloy
    static_configs:
{% for h in groups['vms'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:12345']
        labels: {instance: '{{ h }}'}
{% endfor %}
