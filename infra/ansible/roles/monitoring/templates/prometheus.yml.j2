# {{ ansible_managed }}
global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
{% for h in groups['all'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:9100']
        labels: {instance: '{{ h }}'}
{% endfor %}

  - job_name: cadvisor
    static_configs:
{% for h in groups['all'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:8080']
        labels: {instance: '{{ h }}'}
{% endfor %}

  # 데이터 티어 exporters (fb-data)
  - job_name: postgres
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9187']
        labels: {instance: 'fb-data'}

  - job_name: redis
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9121']
        labels: {instance: 'fb-data'}

  - job_name: elasticsearch
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9114']
        labels: {instance: 'fb-data'}

  - job_name: kafka
    static_configs:
      - targets: ['{{ hostvars['fb-data'].ansible_host }}:9308']
        labels: {instance: 'fb-data'}
