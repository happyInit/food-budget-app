    {"asDropdown": false, "icon": "external link", "includeVars": false, "keepTime": true, "tags": [], "targetBlank": false, "title": "Observability Health", "type": "link", "url": "/d/fba-observability-health/05-observability-health"}
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Prometheus가 선택한 FastAPI 서비스의 /metrics를 정상 수집하는지 보여줍니다. DOWN이면 다른 RED 패널보다 메트릭 배관을 먼저 확인합니다.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [{"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "up{job=~\"fastapi-.*\",service=~\"$service\"}", "legendFormat": "{{service}}", "range": true, "refId": "A"}],
      "title": "Service Metrics Status",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "선택한 서비스가 처리하는 초당 HTTP 요청 수입니다. method별 트래픽 급증·급감을 확인합니다.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisLabel": "requests/s", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": false}, "min": 0, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 4},
      "id": 2,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by(service, method) (rate(http_requests_total{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\"}[$__rate_interval]))", "legendFormat": "{{service}} {{method}}", "range": true, "refId": "A"}],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "전체 요청 중 2xx 성공과 4xx·5xx 오류 비율입니다. 4xx는 사용자/인증 문제, 5xx는 서버 장애 가능성을 우선 조사합니다.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisLabel": "ratio", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": false}, "max": 1, "min": 0, "unit": "percentunit"}, "overrides": [{"matcher": {"id": "byRegexp", "options": "/4xx|5xx/"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}]},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 4},
      "id": 3,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "sum(rate(http_requests_total{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\",status=\"2xx\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\"}[$__rate_interval])), 0.000001)", "legendFormat": "2xx Success", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum(rate(http_requests_total{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\",status=\"4xx\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\"}[$__rate_interval])), 0.000001)", "legendFormat": "4xx", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "sum(rate(http_requests_total{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\",status=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\"}[$__rate_interval])), 0.000001)", "legendFormat": "5xx", "range": true, "refId": "C"}
      ],
      "title": "Success & Error Ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "선택한 서비스·경로의 응답시간 분포입니다. 평균 대신 p50·p95·p99를 함께 봐서 일부 느린 요청을 놓치지 않습니다.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisLabel": "seconds", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": false}, "min": 0, "unit": "s"}, "overrides": [{"matcher": {"id": "byName", "options": "p99"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}]},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 4},
      "id": 4,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "histogram_quantile(0.50, sum by(le) (rate(http_request_duration_seconds_bucket{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\"}[$__rate_interval])))", "legendFormat": "p50", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by(le) (rate(http_request_duration_seconds_bucket{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\"}[$__rate_interval])))", "legendFormat": "p95", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "histogram_quantile(0.99, sum by(le) (rate(http_request_duration_seconds_bucket{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\"}[$__rate_interval])))", "legendFormat": "p99", "range": true, "refId": "C"}
      ],
      "title": "Request Duration",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "handler별 요청량을 비교합니다. 트래픽이 몰리거나 갑자기 사라진 endpoint를 찾는 진입점입니다.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisLabel": "requests/s", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": false}, "min": 0, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 12},
      "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by(handler) (rate(http_requests_total{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\"}[$__rate_interval]))", "legendFormat": "{{handler}}", "range": true, "refId": "A"}],
      "title": "Endpoint Traffic",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "handler별 4xx·5xx 비율입니다. 비율이 높은 endpoint를 선택한 뒤 오류 로그와 Trace에서 원인을 조사합니다.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisLabel": "error ratio", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": false}, "max": 1, "min": 0, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 12},
      "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by(handler) (rate(http_requests_total{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\",status=~\"4xx|5xx\"}[$__rate_interval])) / clamp_min(sum by(handler) (rate(http_requests_total{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\"}[$__rate_interval])), 0.000001)", "legendFormat": "{{handler}}", "range": true, "refId": "A"}],
      "title": "Endpoint Error Ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "현재 처리 중인 요청 수입니다. 요청량은 비슷한데 이 값이 계속 증가하면 처리 정체나 의존성 지연을 의심합니다.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 20}, {"color": "red", "value": 50}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 21},
      "id": 7,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "sum by(handler) (http_requests_inprogress{job=~\"fastapi-.*\",service=~\"$service\",handler=~\"$route\"})", "legendFormat": "{{handler}}", "range": true, "refId": "A"}],
      "title": "Requests In Progress",
      "type": "stat"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "선택한 서비스의 최근 ERROR·CRITICAL 구조화 로그입니다. trace_id가 있으면 해당 요청 Trace로 이동할 수 있습니다.",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 21},
      "id": 8,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "editorMode": "code", "expr": "{service_name=~\"$service\"} | json | level=~\"ERROR|CRITICAL\"", "queryType": "range", "refId": "A"}],
      "title": "Recent Error Logs",
      "type": "logs"
    },
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "description": "선택한 서비스에서 오류가 발생했거나 500ms보다 느린 Trace를 보여줍니다. Trace를 열어 FastAPI·DB·Redis·Elasticsearch span 중 지연 구간을 확인합니다.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 29},
      "id": 9,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [{"datasource": {"type": "tempo", "uid": "tempo"}, "limit": 20, "query": "{ resource.service.name =~ \"${service:regex}\" && (span:status = error || duration > 500ms) }", "queryType": "traceql", "refId": "A", "tableType": "traces"}],
      "title": "Recent Slow & Error Traces",
      "type": "table"
    }
  ],
  "refresh": "30s",
