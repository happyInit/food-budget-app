# {{ ansible_managed }}
# etcd at-rest 암호화 — Secret 을 aescbc 로 암호화해 etcd 디스크·스냅샷에 저장한다.
#   provider 순서 = 암호화 먼저(aescbc) → 읽기 폴백(identity).
#   → 새 write 는 aescbc 로 암호화, 기존 평문 Secret 은 identity 로 계속 읽힌다(재암호화 전까지).
#   🔴 키(etcd_encryption_key) = secrets.yml. 스냅샷(S3)과 분리 보관. 잃으면 암호화된 스냅샷 복호 불가.
apiVersion: apiserver.config.k8s.io/v1
kind: EncryptionConfiguration
resources:
  - resources:
      - secrets
    providers:
      - aescbc:
          keys:
            - name: key1
              secret: {{ etcd_encryption_key }}
      - identity: {}
