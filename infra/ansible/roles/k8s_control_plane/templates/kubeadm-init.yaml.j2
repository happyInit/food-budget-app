# {{ ansible_managed }}
# kubeadm 부트스트랩 설정 (API v1beta4 — 1.31+ 정본).
# ⚠️ 이 파일을 나중에 고쳐도 이미 초기화된 클러스터엔 자동 반영되지 않는다.
#    반영 경로는 `kubeadm upgrade` / `kubectl -n kube-system edit cm kubeadm-config` 다.
#
# ⚠️ 첫 줄에 `---` 를 두지 말 것 — 주석만 있는 빈 문서가 하나 생겨 kubeadm 이
#    "kind and apiVersion is mandatory" 로 거부한다(2026-07-27 실제로 밟음).
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ k8s_api_endpoint }}
  bindPort: {{ k8s_api_port }}
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: {{ k8s_api_endpoint }}
  # 기본값과 같지만 명시한다 — master 에 워크로드를 올리지 않는 것이 RAM 예산의 전제다
  # (그래도 DaemonSet 은 toleration 을 갖고 올라온다 — 플랜 §2.2 의 6GB 근거).
  taints:
    - key: node-role.kubernetes.io/control-plane
      effect: NoSchedule
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: v{{ k8s_version_plain }}
# 단일 master 지만 endpoint 를 박아 둔다 — 나중에 물리 3대가 되어 HA 로 갈 때
# 인증서 SAN 재발급 범위를 줄인다(플랜 §2.1: 물리 2대에서 3-master 는 착시).
controlPlaneEndpoint: "{{ k8s_api_endpoint }}:{{ k8s_api_port }}"
networking:
  podSubnet: {{ k8s_pod_cidr }}
  serviceSubnet: {{ k8s_service_cidr }}
  dnsDomain: cluster.local
apiServer:
  certSANs:
    - {{ k8s_api_endpoint }}
    - 127.0.0.1
    - {{ inventory_hostname }}
{% if (etcd_encryption_enabled | default(false)) or (cis_profiling_disabled | default(true)) %}
  extraArgs:
{% if etcd_encryption_enabled | default(false) %}
    # etcd at-rest 암호화 (Secret) — enc config 파일 + hostPath 볼륨. 라이브 적용·롤백은
    #   tasks 의 etcd_encryption 태그(apiserver 매니페스트 재생성). 신규 클러스터는 init 이 바로 반영.
    - name: encryption-provider-config
      value: /etc/kubernetes/enc/encryption-config.yaml
{% endif %}
{% if cis_profiling_disabled | default(true) %}
    # CIS 1.2.15 — pprof 엔드포인트를 끈다. 인증은 걸려 있지만 운영에 쓰지 않는 디버그 표면이고
    #   끄는 비용이 0 이다. 프로파일링이 필요하면 그때 일시적으로 되돌린다(이 변수를 false 로).
    - name: profiling
      value: "false"
{% endif %}
{% if cis_audit_enabled | default(true) %}
    # CIS 1.2.16~19 — 감사 로그. 이 4개는 한 덩어리다(경로·보존·개수·크기).
    # 🔴 maxsize·maxbackup 이 곧 디스크 상한이다: 100MB × (10 백업 + 1 현재) = **최대 1.1GB**.
    #    상한 없이 켜면 마스터 디스크가 차고, 그러면 **apiserver 가 선다** = 클러스터 정지다.
    #    감사 로그를 켜는 작업이 클러스터를 죽이는 가장 흔한 경로가 이것이라 반드시 같이 건다.
    #    (마스터 실측 2026-08-03: 48G 중 43G 여유 → 1.1GB 는 2.5%)
    - name: audit-policy-file
      value: /etc/kubernetes/audit/policy.yaml
    - name: audit-log-path
      value: /var/log/kubernetes/audit/audit.log
    - name: audit-log-maxage
      value: "30"
    - name: audit-log-maxbackup
      value: "10"
    - name: audit-log-maxsize
      value: "100"
{% endif %}
{% endif %}
{% if (etcd_encryption_enabled | default(false)) or (cis_audit_enabled | default(true)) %}
  extraVolumes:
{% if etcd_encryption_enabled | default(false) %}
    - name: enc
      hostPath: /etc/kubernetes/enc
      mountPath: /etc/kubernetes/enc
      readOnly: true
      pathType: DirectoryOrCreate
{% endif %}
{% if cis_audit_enabled | default(true) %}
    # 정책은 읽기 전용으로 — apiserver 가 자기 감사 규칙을 고칠 수 있으면 안 된다.
    - name: audit-policy
      hostPath: /etc/kubernetes/audit
      mountPath: /etc/kubernetes/audit
      readOnly: true
      pathType: DirectoryOrCreate
    # 로그는 쓰기 필요. 🔴 /var/log 밑에 두는 이유 = 컨테이너 밖(호스트)에 남겨야
    #    apiserver 가 죽은 뒤에도 "죽기 직전에 무슨 일이 있었나" 를 읽을 수 있다.
    - name: audit-logs
      hostPath: /var/log/kubernetes/audit
      mountPath: /var/log/kubernetes/audit
      readOnly: false
      pathType: DirectoryOrCreate
{% endif %}
{% endif %}
{% if cis_profiling_disabled | default(true) %}
# CIS 1.3.2 / 1.4.1 — controller-manager · scheduler 도 같은 이유로 끈다.
#   🔴 이 둘은 apiserver 와 달리 **localhost 바인딩**이라 노출면이 더 좁다. 그래도 끄는 이유는
#      "기본값이라서 켜져 있었다" 를 남기지 않기 위해서다(설정이 곧 의도의 기록).
controllerManager:
  extraArgs:
    - name: profiling
      value: "false"
scheduler:
  extraArgs:
    - name: profiling
      value: "false"
{% endif %}
etcd:
  local:
    dataDir: /var/lib/etcd
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
# containerd 의 SystemdCgroup=true 와 짝을 맞춘다 — 어긋나면 메모리 회계가 갈려
# "축출은 안 도는데 OOM 이 난다"가 된다.
cgroupDriver: systemd
# 🔴 예약을 명시하는 이유: 기본값은 예약 0 + 축출 임계 100Mi 라, 노드가 꽉 차면
#    kubelet·containerd·sshd 가 파드와 같은 메모리를 다툰다(= 노드 자체를 잃는다).
#    master 6GB 결정과 한 세트다(플랜 §2.2).
systemReserved:
  cpu: 200m
  memory: 512Mi
kubeReserved:
  cpu: 200m
  memory: 512Mi
evictionHard:
  memory.available: 200Mi
  nodefs.available: 10%
  imagefs.available: 15%
