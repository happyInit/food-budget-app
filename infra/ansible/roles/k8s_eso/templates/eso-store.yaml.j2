# {{ ansible_managed }}
# ESO 백엔드 = **Kubernetes provider** (2026-07-27 확정).
#
# 구조: 비밀의 정본은 `{{ eso_source_namespace }}` ns 의 Secret 하나뿐이고, ESO 가 그것을
# 각 워크로드 ns 로 복제한다(ExternalSecret 리소스는 P1 에서 앱과 함께 들어온다).
# 얻는 것:
#   · 워크로드 ns 에 비밀 원본이 없다 → ns 별 RBAC 이 곧 비밀 접근 통제가 된다
#   · 나중에 Vault·클라우드 KMS 로 갈 때 **ExternalSecret 은 그대로 두고 Store 만 교체**
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ eso_source_namespace }}
  labels:
    pod-security.kubernetes.io/enforce: restricted
---
# ESO 가 정본 ns 를 읽을 때 쓸 신원. 권한은 **읽기 전용 · 그 ns 한정**이다.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: eso-reader
  namespace: {{ eso_source_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: eso-reader
  namespace: {{ eso_source_namespace }}
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list", "watch"]
  # provider 가 접근 가능 여부를 미리 확인할 때 쓴다(없으면 store 가 Invalid 로 뜬다).
  - apiGroups: ["authorization.k8s.io"]
    resources: ["selfsubjectrulesreviews"]
    verbs: ["create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: eso-reader
  namespace: {{ eso_source_namespace }}
subjects:
  - kind: ServiceAccount
    name: eso-reader
    namespace: {{ eso_source_namespace }}
roleRef:
  kind: Role
  name: eso-reader
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: {{ eso_store_name }}
spec:
  # 🔴 이 스토어를 참조할 수 있는 ns 를 명시적으로 제한한다 (0-14b · S4-1, 2026-08-09 실측).
  #
  #   conditions 가 비어 있으면 **어느 ns 에서든** 이 스토어를 참조할 수 있다. 그런데
  #   백엔드 SA `eso-reader` 의 Role 은 `secrets [get,list,watch]` 에 resourceNames 가 없어
  #   `{{ eso_source_namespace }}` **전체**를 읽는다. 그리고 ESO 차트가 들여오는
  #   `external-secrets-edit` ClusterRole 에 `aggregate-to-edit` 라벨이 붙어 있어
  #   **그 ns 의 edit 보유자는 externalsecrets 를 만들 수 있다**(실측 확인).
  #
  #   ⇒ ExternalSecret 하나로 {{ eso_source_namespace }} 의 시크릿 전량을 자기 ns 로 복사할 수 있었다.
  #      거기엔 `harbor-pull`(레지스트리)과 `repo-food-budget-config`(**config 레포 쓰기 SSH 키**)가
  #      들어 있다 — 즉 시크릿 유출이 곧 배포 파이프라인 장악이다.
  #
  #   ⚠️ 경계를 정확히: 위험은 **읽기 한정**이었다. 스토어 capabilities 는 ReadWrite 지만
  #      `eso-reader` Role 에 create/update 가 없어 PushSecret(원본 오염)은 RBAC 에서 실패한다.
  #
  #   🔴 이건 0-14(RBAC 커스텀 롤)보다 **먼저** 적용돼야 한다. 롤을 좁혀도 이 우회로가 열려 있으면
  #      효과가 0이다.
  #
  # 왜 라벨 셀렉터가 아니라 이름 목록인가:
  #   대상 ns 에 용도 라벨이 하나도 없다(실측 — `kubernetes.io/metadata.name` 과 PSA 3종뿐).
  #   라벨을 새로 붙이는 선행작업이 필요해지고, 그 라벨은 ns 를 만드는 쪽(Ansible·수동)에
  #   또 다른 암묵 계약을 만든다. 이름 목록은 자기설명적이고 diff 로 심사된다.
  #   🔴 대신 **새 ns 에 ExternalSecret 을 추가하면 여기에도 추가해야 한다** — 안 하면
  #      그 ExternalSecret 이 `SecretSyncedError`(store 참조 거부)로 조용히 안 뜬다.
  conditions:
    - namespaces:
{% for ns in eso_allowed_namespaces %}
        - {{ ns }}
{% endfor %}
  provider:
    kubernetes:
      remoteNamespace: {{ eso_source_namespace }}
      server:
        # 클러스터 자신을 가리킨다 — apiserver CA 는 모든 ns 에 뿌려지는 kube-root-ca.crt 사용
        caProvider:
          type: ConfigMap
          name: kube-root-ca.crt
          key: ca.crt
          namespace: {{ eso_source_namespace }}
      auth:
        serviceAccount:
          name: eso-reader
          namespace: {{ eso_source_namespace }}
