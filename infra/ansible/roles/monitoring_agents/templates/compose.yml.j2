# {{ ansible_managed }}
# 관측 에이전트 — 전 VM (메트릭 스크레이프 + 로그 수집)
services:
  node-exporter:
    image: quay.io/prometheus/node-exporter:latest
    container_name: node-exporter
    restart: unless-stopped
    network_mode: host
    pid: host
    command:
      - '--path.rootfs=/host'
      - '--collector.textfile.directory=/host/var/lib/node_exporter/textfile_collector'
    volumes:
      - '/:/host:ro,rslave'
    deploy:
      resources:
        limits:
          memory: 128M
          cpus: "0.3"

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest
    container_name: cadvisor
    restart: unless-stopped
    privileged: true
    ports:
      - "8080:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: "0.5"

  # Grafana Alloy — 컨테이너·poller 파일 로그를 Loki로 전송
  alloy:
    image: grafana/alloy:latest
    container_name: alloy
    restart: unless-stopped
    user: root
    command:
      - run
      - /etc/alloy/config.alloy
      - --server.http.listen-addr=0.0.0.0:12345
      - --storage.path=/var/lib/alloy/data
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
{% if inventory_hostname in groups['data'] %}
      # fb-data host cron poller 로그 — Alloy는 읽기만 가능
      - /var/log/fb-pollers:/var/log/fb-pollers:ro
{% endif %}
      - alloy_data:/var/lib/alloy/data
    ports:
      - "12345:12345"
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: "0.3"

volumes:
  alloy_data:
