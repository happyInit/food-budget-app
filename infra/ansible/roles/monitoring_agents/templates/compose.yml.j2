# {{ ansible_managed }}
# 관측 에이전트 — 전 VM (메트릭 스크레이프 + 로그 수집)
services:
  node-exporter:
    image: quay.io/prometheus/node-exporter:latest
    container_name: node-exporter
    restart: unless-stopped
    network_mode: host
    pid: host
    command:
      - '--path.rootfs=/host'
      - '--collector.textfile.directory=/host/var/lib/node_exporter/textfile_collector'
    volumes:
      - '/:/host:ro,rslave'
    deploy:
      resources:
        limits:
          memory: 128M
          cpus: "0.3"

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest
    container_name: cadvisor
    restart: unless-stopped
    privileged: true
    ports:
      - "8080:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    deploy:
      resources:
        limits:
          # 256M 이었으나 실측 최대 사용률이 fb-app-ai 99.9% · fb-ci-harbor 93.5% ·
          # fb-data 86.9% 로 상시 한계선이었고, 2026-07-22 디스크 폭주 때 실제로
          # OOM-kill 됐다. 하필 그 구간 컨테이너 메트릭이 통째로 비어 사후분석을
          # 방해했다 — 감시 에이전트가 정작 사고 때 죽는 건 본말전도다.
          # VM 별 가용 RAM 이 3.1~5.2GB 라 배증은 부담 없음.
          memory: 512M
          cpus: "0.5"

  # Grafana Alloy — 컨테이너 로그를 Loki로 전송 (+ 향후 트레이스 수신)
  alloy:
    image: grafana/alloy:latest
    container_name: alloy
    restart: unless-stopped
    user: root
    # 설정 내용이 바뀌면 Compose 서비스 정의도 바뀌게 하여 Alloy를 자동 재생성한다.
    # 단일 파일 bind mount가 이전 inode를 계속 보는 문제를 방지한다.
    labels:
      monitoring.alloy.config-sha256: "{{ alloy_config_file.stat.checksum }}"
    command:
      - run
      - /etc/alloy/config.alloy
      - --server.http.listen-addr=0.0.0.0:12345
      - --storage.path=/var/lib/alloy/data
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - alloy_data:/var/lib/alloy/data
    ports:
      - "12345:12345"
    deploy:
      resources:
        limits:
          memory: 512M
          # 🔴 CPU 캡 0.3 제거(2026-07-30) — 호스트 C 웨지 2회(HTTP·로그 완전 침묵, 프로세스 생존)의
          #    유력 원인. 실측: 웨지 시점마다 호스트 load 3+ 에서 alloy CPU 가 정확히 캡(≈34%)에
          #    붙어 있었다 = CFS 스로틀링으로 서버 goroutine 기아(object_spec §13.7 과 같은 계열).
          #    메모리 캡만 유지(폭주 방어) — 재발 시 그때 loki.write 백프레셔 가설로 넘어간다.

volumes:
  alloy_data:
