// {{ ansible_managed }}
// 이 VM의 모든 컨테이너 로그를 인클러스터 Loki 로 전송 (모니터링 컷오버 ④, 2026-07-30 — 구 행선지 .11)

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = {"host" = "{{ inventory_hostname }}"}
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    // 인클러스터 Loki 의 NodePort 유입구(mp-loki-push-nodeport, config repo platform/argocd/loki.yaml).
    // NodePort 는 전 노드에 열리지만 URL 은 하나라 master 를 지정 — master 재부팅 중엔
    // alloy 가 WAL 로 버퍼링 후 재전송한다. .15 내부 게이트웨이가 서면 그쪽으로 이관.
    url = "http://{{ hostvars['k8s-master'].ansible_host }}:31100/loki/api/v1/push"
  }
}
