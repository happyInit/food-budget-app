# {{ ansible_managed }}
# 플랫폼 계층 AppProject — "ArgoCD 가 동기화하는 플랫폼 스택"(LGTM 선배포가 첫 입주자)의 울타리.
#
# config 레포(mealplanning 프로젝트·앱 트랙)와 **완전히 독립**이다:
#   · 소스가 공개 Helm 차트 레포라 자격증명·레포 생성이 필요 없다 → 항상 배선된다
#   · Application CR 정본 = Ansible `roles/k8s_platform_apps` (앱 매니페스트 정본 = config 레포와 대비)
#   · 나중에 플랫폼 매니페스트의 git 집이 정해지면(P2 전 결정) sourceRepos 에 그 URL 만 추가한다
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: {{ argocd_platform_project }}
  namespace: {{ argocd_namespace }}
spec:
  description: 플랫폼 스택 (관측 등) — Application 정본은 Ansible(k8s_platform_apps)
  sourceRepos:
{% for repo in argocd_platform_source_repos %}
    - {{ repo }}
{% endfor %}
  destinations:
{% for ns in argocd_platform_namespaces %}
    - server: https://kubernetes.default.svc
      namespace: {{ ns }}
{% endfor %}
  # 클러스터 스코프는 Alloy(로그 수집 DaemonSet)의 RBAC 두 종만 허용한다.
  # ns·CRD 는 여전히 Ansible 소관(k8s_cluster_base) — 사고 반경을 관측 계층에 묶는다.
  clusterResourceWhitelist:
    - group: rbac.authorization.k8s.io
      kind: ClusterRole
    - group: rbac.authorization.k8s.io
      kind: ClusterRoleBinding
  namespaceResourceWhitelist:
    - group: "*"
      kind: "*"
