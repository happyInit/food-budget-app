# {{ ansible_managed }}
# ArgoCD ↔ config 레포 배선.
#
# 🔴 **자격증명을 ArgoCD ns 에 직접 만들지 않는다.** 정본은 `{{ eso_source_namespace }}` ns 의 Secret 하나이고
#    ESO 가 argocd ns 로 복제한다. 얻는 것:
#      · 비밀 원본이 워크로드 ns 에 없다 → ns 별 RBAC 이 곧 접근 통제가 된다
#      · P1 에서 앱 비밀(.env 정본)이 탈 파이프라인을 **지금 실물로 검증**하게 된다
#      · 나중에 Vault 로 가도 ExternalSecret 은 그대로, Store 만 교체
---
# ① 정본 — fb-secrets ns
apiVersion: v1
kind: Secret
metadata:
  name: {{ argocd_repo_secret }}
  namespace: {{ eso_source_namespace }}
type: Opaque
stringData:
  # ArgoCD repository Secret 이 요구하는 키 이름 그대로 둔다(아래 ExternalSecret 이 통째로 복제).
  type: git
  url: {{ argocd_repo_url }}
  sshPrivateKey: |
{{ argocd_repo_ssh_key | indent(4, true) }}
---
# ② 복제본 — argocd ns. 라벨이 있어야 ArgoCD 가 "레포 자격증명"으로 인식한다.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ argocd_repo_secret }}
  namespace: {{ argocd_namespace }}
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: {{ eso_store_name }}
    kind: ClusterSecretStore
  target:
    name: {{ argocd_repo_secret }}
    creationPolicy: Owner
    template:
      metadata:
        labels:
          # 🔴 이 라벨이 없으면 ArgoCD 는 그냥 평범한 Secret 으로 보고 무시한다.
          argocd.argoproj.io/secret-type: repository
  dataFrom:
    - extract:
        key: {{ argocd_repo_secret }}
---
# ③ (삭제됨 2026-08-10) `mealplanning` AppProject 는 여기 있었다.
#    🔴 **정본은 `argocd-mealplanning-project.yaml.j2` 하나다.** 2026-08-06(#551)에 그 템플릿이
#    신설됐는데 여기 있던 정의를 걷어내지 않아 **같은 AppProject 를 두 파일이 만들고 있었다.**
#    task 순서상 이 파일이 뒤에 apply 돼서, 롤을 돌릴 때마다 `mp-ingress` destination 이
#    조용히 삭제되고 `mp-ingress` Application 이 배포 거부로 죽는 상태였다(§경위는 커밋 메시지).
#    AppProject 정의를 여기에 다시 넣지 말 것 — 이 파일은 **레포 자격증명 배선**이 소관이다.
#
# ④ root 전용 울타리 (2026-07-28 신설) — config 레포가 app-of-apps 구조로 확정되면서 필요해졌다.
#    root Application 은 argocd ns 에 child Application "오브젝트"를 만들어야 하는데,
#    `mealplanning` 프로젝트는 app·data·pipeline·mp-ingress 만 허용해 root 가
#    InvalidSpecError 로 막혔다(실측). mealplanning 에 argocd ns 를 추가하면 화이트리스트가
#    전역(*/*)이라 argocd ns 에 아무 리소스나 만들 수 있게 된다 → root 전용 프로젝트로 분리해
#    **Application 딱 한 종류만** 허용.
#    child 들은 각자 spec.project=mealplanning 이므로 기존 울타리 그대로다.
#    ⚠️ root Application 의 spec.project 는 앱 담당자가 {{ argocd_root_project }} 로 지정해야 한다.
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: {{ argocd_root_project }}
  namespace: {{ argocd_namespace }}
spec:
  description: app-of-apps root 전용 — argocd ns 에 Application 오브젝트만 생성 가능
  sourceRepos:
    - {{ argocd_repo_url }}
  destinations:
    - server: https://kubernetes.default.svc
      namespace: {{ argocd_namespace }}
  clusterResourceWhitelist: []
  namespaceResourceWhitelist:
    - group: argoproj.io
      kind: Application
