# {{ ansible_managed }}
# ArgoCD 웹훅 시크릿 **전용** values — 메인 argocd-values.yaml(0644) 와 분리한다.
#   configs.secret.githubSecret → argocd-secret 의 `webhook.github.secret` 로 들어가
#   GitHub 이 보낸 push 이벤트의 HMAC 서명을 ArgoCD 가 검증한다(위조 요청 차단).
#   이 파일은 0600·no_log 로 렌더된다(월드리더블 유출 방지) — tasks/main.yml 참조.
#
# 웹훅 비활성(argocd_webhook_enabled=false)이면 빈 문자열 = 차트 기본값(no-op).
# createSecret 은 차트 기본 true — argocd-secret 은 차트가 소유하므로 여기서 안전하게 세팅.
configs:
  secret:
    githubSecret: "{{ argocd_webhook_github_secret | default('') }}"
