# {{ ansible_managed }}
# ArgoCD 시크릿 관련 values — 메인 argocd-values.yaml(0644) 와 분리한다(0600·no_log).
#
# 🔴 **createSecret: false 인 이유 — 2026-07-30 실사고**
#   종전 주석은 "argocd-secret 은 차트가 소유하므로 여기서 안전하게 세팅"이라고 했는데 **틀렸다.**
#   차트는 이 Secret 을 **data 키 없이** 렌더한다(configs.secret.* 를 안 채우면 빈 껍데기).
#   그런데 `server.secretkey`·`admin.password` 는 **argocd-server 가 런타임에 만들어 넣는 값**이라
#   차트 렌더에 없다 → `helm upgrade` 가 그 둘을 **지운다**.
#   실제 피해: `--tags argocd` 를 돌린 뒤 UI 가 "unable to load data: server.secretkey is missing" 로
#   전면 불통, admin 비밀번호 소실(해시만 저장돼 복구 불가). argocd-server 재시작으로 재생성해 복구했다.
#   → **런타임이 소유하는 값을 IaC 가 덮어쓰지 않게** 차트에서 이 Secret 을 떼어낸다.
#
#   Secret 자체는 tasks/main.yml 이 "없으면 생성"(데이터는 안 건드림) + `helm.sh/resource-policy: keep`
#   으로 지킨다 — keep 이 없으면 차트 렌더에서 빠지는 순간 helm 이 삭제한다.
#
# 웹훅 시크릿(webhook.github.secret)은 이제 차트가 아니라 tasks 의 kubectl patch 로 그 **키만** 넣는다.
configs:
  secret:
    createSecret: false
