# {{ ansible_managed }}
# MetalLB {{ metallb_version }} — 우리는 **L2 모드만** 쓴다(플랜 §3.3).

# 🔴 FRR / FRR-K8s 를 끈다. 차트 기본값은 frr-k8s DaemonSet(컨테이너 5개/노드) +
#    statuscleaner Deployment 를 얹는데, 이건 **BGP 용**이다. L2Advertisement 만 쓰는
#    우리에겐 기능적 이득이 0 이고 노드마다 상시 메모리만 먹는다(RAM 예산 §2.2).
#    BGP 로 갈 일이 생기면(라우터가 협조해 주는 환경) 그때 켠다.
frrk8s:
  enabled: false
speaker:
  frr:
    enabled: false
  # speaker 는 hostNetwork 로 ARP 에 응답한다 — 노드당 1개(DaemonSet) 고정.
  resources:
    requests:
      cpu: 20m
      memory: 64Mi

controller:
  resources:
    requests:
      cpu: 20m
      memory: 64Mi
