# Managed by Ansible (roles/secrets_backup)
[Unit]
Description=mp secrets/PKI bundle backup → S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ secrets_backup_env_file }}
ExecStart={{ secrets_backup_script }}
# 실패 감지는 백업 신선도 알림(mp_backup_last_object_timestamp_seconds)이 담당한다.
TimeoutStartSec=600
