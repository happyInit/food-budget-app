#!/usr/bin/env bash
# Managed by Ansible (roles/secrets_backup) — 수동 편집 금지(다음 플레이에서 덮어씀).
# kubeadm PKI + etcd 암호화 설정 + 컨트롤머신 비밀 → tar.gz → AES-256 → S3.
#
# 🔴 평문 묶음은 **디스크에 안 쓴다** — 스테이징은 tmpfs(/dev/shm), 종료 시 삭제.
#    tar 는 파이프로 openssl 에 바로 물린다. 디스크에 남는 건 암호문(.enc) 뿐이다.
# 🔴 업로드 전에 **복호 왕복을 검증**한다 ("백업 파일 존재 ≠ 복구 가능", 전략 §6).
set -euo pipefail

TS="$(date -u +%Y%m%dT%H%M%SZ)"
DIR="{{ secrets_backup_local_dir }}"
BUCKET="{{ secrets_backup_s3_bucket }}"
PREFIX="{{ secrets_backup_s3_prefix }}"
REGION="{{ backup_s3_region }}"
ENC="${DIR}/secrets-${TS}.tar.gz.enc"
TMP="${ENC}.partial"

: "${SECRETS_BACKUP_PASSPHRASE:?passphrase 미주입 — EnvironmentFile 확인}"

mkdir -p "${DIR}"; chmod 0700 "${DIR}"

# tmpfs 스테이징 (평문이 물리 디스크에 닿지 않게)
STAGE="$(mktemp -d -p /dev/shm mp-secrets.XXXXXX)"
chmod 0700 "${STAGE}"
trap 'rm -rf "${STAGE}"; rm -f "${TMP}"' EXIT

B="${STAGE}/bundle"
mkdir -p "${B}"

# --- 1) 마스터 측: kubeadm PKI · etcd 암호화 설정 ---
{% for p in secrets_backup_master_paths %}
if [[ -e "{{ p.src }}" ]]; then
  cp -a "{{ p.src }}" "${B}/{{ p.dest }}"
else
  echo "⚠️  없음(건너뜀): {{ p.src }}" >&2
fi
{% endfor %}

# kubeconfig 류 (admin.conf 등) — 재발급 가능하지만 있으면 복구가 빨라진다
mkdir -p "${B}/kubernetes-conf"
shopt -s nullglob
for f in /etc/kubernetes/*.conf; do cp -a "$f" "${B}/kubernetes-conf/"; done
shopt -u nullglob

# --- 2) 컨트롤 머신 측 사본 (Ansible 이 미리 동기화해 둔 디렉토리) ---
if [[ -d "{{ secrets_backup_vault_dir }}" ]]; then
  cp -a "{{ secrets_backup_vault_dir }}" "${B}/control-machine"
fi

# --- 2.5) 🔴 ESO 정본 ns 의 Secret (0-11) ---
# `{{ secrets_backup_eso_namespace }}` 는 ESO 전체의 뿌리인데 **전 IaC 밖에서 손으로 만들어졌다**
# (실측: managedFields 없음·라벨 없음). 여기 안 담으면 복구 경로가 **etcd 스냅샷 + aescbc 키
# 조합 단 하나**뿐이고, etcd 보존 14일이 곧 시크릿의 실질 RPO 가 된다.
#
# ⚠️ 이 묶음은 이미 kubeadm PKI·etcd 암호화 키를 담고 있다 — 즉 **새 SPOF 를 만드는 게 아니라
#    기존 묶음의 폭발 반경 안에 하나를 더 넣는 것**이다. 그 대신 복구가 한 곳에서 끝난다.
#    passphrase 소실 = 전부 복호 불가(2026-07-29 전례). 오프라인 사본 보관은 여전히 필수다.
#
# 🔴 kubectl 은 서버 필드를 잔뜩 붙여준다(resourceVersion·uid·creationTimestamp).
#    그대로 두면 복원 시 apply 가 거부되므로 **여기서 미리 벗긴다** — 복구할 사람이
#    새벽에 그걸 알아내게 만들지 않는다.
#
# 🔴 이 블록은 **비치명적**이다. 스크립트가 `set -e` 라 여기서 죽으면 kubeadm PKI 백업까지
#    통째로 날아간다 — 시크릿 덤프 실패가 PKI 백업 실패를 부르면 안 된다.
#    대신 조용히 넘어가지도 않는다: 실패는 stderr 로 남고 MANIFEST 에 파일이 없어 드러난다.
eso_dump() {
  kubectl --kubeconfig "{{ k8s_kubeconfig }}" -n "{{ secrets_backup_eso_namespace }}" \
    get secret -o json \
    | python3 -c '
import json, sys
doc = json.load(sys.stdin)
doc.pop("metadata", None)   # List 자신의 resourceVersion — 백업에 남을 이유가 없다
keep = ("name", "namespace", "labels", "annotations")
for item in doc.get("items", []):
    item["metadata"] = {k: v for k, v in item["metadata"].items() if k in keep}
    item.pop("status", None)
    ann = item["metadata"].get("annotations") or {}
    ann.pop("kubectl.kubernetes.io/last-applied-configuration", None)
    if ann:
        item["metadata"]["annotations"] = ann
    else:
        item["metadata"].pop("annotations", None)
print(json.dumps(doc, indent=2, sort_keys=True))
' > "${B}/eso-source/secrets.json"
  # 키 이름만 뽑은 인벤토리 — 값 없이 "뭐가 있었나"를 답한다.
  python3 -c '
import json, sys
doc = json.load(open(sys.argv[1]))
inv = {i["metadata"]["name"]: sorted((i.get("data") or {}).keys()) for i in doc.get("items", [])}
print(json.dumps(inv, indent=2, ensure_ascii=False, sort_keys=True))
' "${B}/eso-source/secrets.json" > "${B}/eso-source/INVENTORY.json"
}

if kubectl --kubeconfig "{{ k8s_kubeconfig }}" get ns "{{ secrets_backup_eso_namespace }}" >/dev/null 2>&1; then
  mkdir -p "${B}/eso-source"
  if eso_dump; then
    echo "✅ {{ secrets_backup_eso_namespace }} Secret 덤프 완료 ($(python3 -c '
import json,sys; d=json.load(open(sys.argv[1])); print(sum(len(v) for v in d.values()), "keys /", len(d), "secrets")
' "${B}/eso-source/INVENTORY.json" 2>/dev/null || echo '?'))" >&2
  else
    echo "🔴 {{ secrets_backup_eso_namespace }} 덤프 실패 — PKI 백업은 계속한다. MANIFEST 에 eso-source 가 없으면 이 경우다." >&2
    rm -rf "${B}/eso-source"
  fi
else
  echo "⚠️  없음(건너뜀): ns {{ secrets_backup_eso_namespace }}" >&2
fi

# --- 3) 매니페스트 (뭐가 들어있는지 · 무결성 확인용) ---
{
  echo "# mp 비밀·PKI 묶음"
  echo "# 생성: ${TS} (UTC) · 호스트: $(hostname)"
  echo "# 복원: openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 -in <파일>.enc | tar xzf -"
  echo "#"
} > "${B}/MANIFEST.txt"
( cd "${B}" && find . -type f ! -name MANIFEST.txt -print0 | sort -z | xargs -0 sha256sum ) >> "${B}/MANIFEST.txt"

# --- 4) tar → AES-256 (평문 파일 없이 파이프로) ---
tar czf - -C "${STAGE}" bundle \
  | openssl enc -aes-256-cbc -pbkdf2 -iter 600000 -salt \
      -pass env:SECRETS_BACKUP_PASSPHRASE -out "${TMP}"
chmod 0600 "${TMP}"

# --- 5) 복호 왕복 검증 (여는 것까지 확인해야 백업이다) ---
VERIFY="$(openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 \
            -pass env:SECRETS_BACKUP_PASSPHRASE -in "${TMP}" | tar tzf - | wc -l)"
if [[ "${VERIFY}" -lt 5 ]]; then
  echo "🔴 복호 검증 실패 — 항목 ${VERIFY}개. 업로드 중단." >&2
  exit 1
fi

mv "${TMP}" "${ENC}"

# --- 6) S3 업로드 ---
aws s3 cp "${ENC}" "s3://${BUCKET}/${PREFIX}/" --region "${REGION}" --only-show-errors

# --- 7) 보존 ---
ls -1t "${DIR}"/secrets-*.tar.gz.enc 2>/dev/null | tail -n +{{ secrets_backup_local_keep | int + 1 }} | xargs -r rm -f

CUTOFF="$(date -u -d '{{ secrets_backup_s3_retention_days }} days ago' +%Y%m%dT%H%M%SZ)"
aws s3 ls "s3://${BUCKET}/${PREFIX}/" --region "${REGION}" | awk '{print $4}' \
  | grep -E '^secrets-[0-9]{8}T[0-9]{6}Z\.tar\.gz\.enc$' | while read -r key; do
  keyts="${key#secrets-}"; keyts="${keyts%.tar.gz.enc}"
  if [[ "${keyts}" < "${CUTOFF}" ]]; then
    aws s3 rm "s3://${BUCKET}/${PREFIX}/${key}" --region "${REGION}" --only-show-errors
  fi
done

echo "secrets backup OK (${VERIFY} entries) → s3://${BUCKET}/${PREFIX}/${ENC##*/}"
