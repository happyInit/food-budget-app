# Managed by Ansible (roles/cloudflared) — 수동 편집 금지(다음 플레이에서 덮어씀).
tunnel: {{ cloudflared_tunnel_id }}
credentials-file: {{ cloudflared_config_dir }}/{{ cloudflared_tunnel_id }}.json

ingress:
{% for rule in cloudflared_ingress %}
  - hostname: {{ rule.hostname }}
{% if rule.path is defined %}
    path: {{ rule.path }}
{% endif %}
    service: {{ rule.service }}
{% endfor %}
  - service: http_status:404
