# {{ ansible_managed }}
# Loki·Tempo → MinIO 자격증명. Application values 에는 ${MINIO_...} 자리표시자만 두고
# 실값은 이 Secret 을 extraEnvFrom 으로 물려 -config.expand-env=true 가 치환한다.
#
# root 계정 재사용에 대해: MinIO 차트(5.4.0)의 사용자 분리를 아직 안 쓰고, 소비자가 전부
# 내부 플랫폼(Loki·Tempo)이라 수용한다. 버킷별 사용자 분리는 모델 아티팩트 소비자
# (ranking-serving)가 붙는 시점에 재평가한다.
apiVersion: v1
kind: Secret
metadata:
  name: {{ lgtm_minio_secret }}
  namespace: {{ lgtm_namespace }}
type: Opaque
stringData:
  MINIO_ACCESS_KEY_ID: {{ minio_root_user }}
  MINIO_SECRET_ACCESS_KEY: {{ minio_root_password }}
