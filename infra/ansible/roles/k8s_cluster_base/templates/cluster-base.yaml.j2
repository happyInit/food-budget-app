# {{ ansible_managed }}
# 네임스페이스 설계 = mp_k8s_infra_object_spec.md §1.2 · 정책 3종 = §1.4
#
# PSS(Pod Security Standards) 적용 방침:
#   app          = enforce **restricted** (프론트 비특권 이미지 전환이 P1 체크리스트에 있음)
#   그 외         = enforce baseline + warn/audit restricted
#     → 오퍼레이터가 만드는 파드(CNPG·ECK·Strimzi)를 restricted 로 막아 버리면 P2 에서
#       원인 찾기 어려운 실패가 난다. 대신 warn/audit 으로 "무엇이 걸릴지"를 미리 본다.
---
apiVersion: v1
kind: Namespace
metadata:
  name: app
  labels:
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
    # Istio 사이드카 주입 대상 = app ns 뿐 (플랜 §4.3 메시 경계).
    # istiod 설치 전에는 웹훅이 없어 아무 효과가 없다 — 미리 붙여도 안전하다.
    istio-injection: enabled
---
apiVersion: v1
kind: Namespace
metadata:
  name: data
  labels:
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
---
apiVersion: v1
kind: Namespace
metadata:
  name: pipeline
  labels:
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
---
apiVersion: v1
kind: Namespace
metadata:
  name: observability
  labels:
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
---
apiVersion: v1
kind: Namespace
metadata:
  name: argocd
  labels:
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
---
# PriorityClass — 노드 압박 시 죽는 순서를 선언으로 고정한다(§1.4).
# 절대값에는 의미가 없고 **상대 순서만** 의미가 있다. 셋 다 system-cluster-critical
# (2000000000) 보다 훨씬 낮게 두어 컨트롤플레인 부속을 밀어내지 않게 한다.
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: data-critical
value: 1000000
globalDefault: false
description: "PG·ES·Kafka·Redis — 마지막까지 살아남아야 하는 상태 저장 계층"
---
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: app-normal
value: 100000
globalDefault: false
description: "앱 11 워크로드 + PGSync(서빙 인덱스 생산자라 app 급 — object_spec §2.2)"
---
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: pipeline-low
value: 1000
globalDefault: false
description: "크롤러·CronJob·재학습 — 압박 시 가장 먼저 밀려나야 하는 배치성 작업"
