# Ansible 관리 — 수동 편집 금지
tunnel: {{ cloudflared_tunnel_id }}
credentials-file: {{ cloudflared_config_dir }}/{{ cloudflared_tunnel_id }}.json

# 🔴 로그를 남긴다 — 경로 규칙이 의도대로 걸리는지 확인할 유일한 창이다.
loglevel: info

ingress:
{% if cloudflared_expose_all %}
  # 전체 개방 — 🔴 **Cloudflare Access 가 앞에 있을 때만** 이 모드를 쓴다(C-61④).
  - hostname: {{ cloudflared_hostname }}
    service: {{ cloudflared_service_url }}
{% else %}
  # 🔴 경로 제한 모드 — 아래 목록만 통과하고 나머지는 전부 404.
  #    AWS STS 가 익명으로 읽어야 하는 두 문서만 연다(A-50).
{% for p in cloudflared_public_paths %}
  - hostname: {{ cloudflared_hostname }}
    path: {{ p }}
    service: {{ cloudflared_service_url }}
{% endfor %}
  # 🔴 **catch-all 이 404 다** — 이 줄이 없으면 cloudflared 가 뜨지 않는다(마지막 규칙은
  #    hostname 없는 service 여야 한다). 그리고 이 줄이 UI·git 을 막는 실체다.
  - service: http_status:404
{% endif %}
