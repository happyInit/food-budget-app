# Cilium — EKS ENI 모드 (C-82). 🔴 온프렘 값과 **의도적으로 다르다**.
#
# 온프렘 대비 바뀌는 것:
#   ipam.mode        cluster-pool → eni      C-82: EKS API 서버가 오버레이로 패킷을 못 보낸다
#   routingMode      tunnel(VXLAN) → native  ENI 모드는 파드 IP 가 VPC 주소라 캡슐화가 불필요
#   encryption       WireGuard → **끔**       🔴 A-37 미검증 (아래)
#   k8sServiceHost   .17 → EKS 엔드포인트     kube-proxy 가 없으므로 API 주소를 직접 알아야 한다
#
# 🔴 **WireGuard 를 켜지 않는다** — 온프렘은 켜져 있지만 `A-37`(WireGuard × ENI 모드 지원 확인)이
#    **미검증**이다. 켰다가 안 되면 파드 간 통신이 조용히 죽는 부류라, 검증 전에는 끈다.
#    ⇒ 그 대가 = 노드 간 파드 트래픽이 VPC 안에서 평문이다. VPC 내부이고 SG 로 닫혀 있지만
#      온프렘 대비 후퇴분이므로 A-37 을 닫고 다시 판정한다.
ipam:
  mode: eni

eni:
  enabled: true
  # 🔴 첫 번째 ENI(인덱스 0)는 노드 자신의 것이다. 1 부터 파드용으로 쓴다.
  firstInterfaceIndex: 1
  # 서브넷/SG 를 태그로 고른다 — 안 주면 Cilium 이 추정하고, 추정이 틀리면
  # 파드가 **데이터 서브넷처럼 나갈 길 없는 곳**에 붙을 수 있다.
  subnetTagsFilter:
    - "{{ eks_cilium_subnet_tag_key }}={{ eks_cilium_subnet_tag_value }}"
  securityGroupTags:
    "{{ eks_cilium_subnet_tag_key }}": "{{ eks_cilium_subnet_tag_value }}"
  # 🔴 A-44 — 파드가 노드 SG 를 물려받는다(파드별 SG 가 아니다).
  #    ⇒ 파드 단위 통제는 **CiliumNetworkPolicy** 가 한다. SG 를 느슨하게 잡고
  #      "파드별 SG 가 있으니 괜찮다" 로 읽으면 안 된다.
  awsReleaseExcessIPs: true

# ENI 모드는 캡슐화가 없다 — 파드 IP 가 VPC 주소이므로 VPC 라우팅이 그대로 배달한다.
routingMode: native
endpointRoutes:
  enabled: true
# 노드 밖(인터넷)으로 나갈 때만 SNAT. 파드↔파드는 원본 IP 를 유지한다.
enableIPv4Masquerade: true
egressMasqueradeInterfaces: eth0

# kube-proxy 미설치 (C-82 · Terraform bootstrap_self_managed_addons=false)
kubeProxyReplacement: "true"
k8sServiceHost: "{{ eks_cluster_endpoint | regex_replace('^https://', '') }}"
k8sServicePort: 443

# 🔴 operator 는 CNI 가 없는 상태에서 **먼저** 떠야 한다(자기가 CNI 를 만든다).
operator:
  replicas: 1

  # 🔴 **리전을 명시한다 — 없으면 ENI 할당이 통째로 안 된다**(2026-08-13 실측 · 결함 #15).
  #    증상:
  #      level=error msg="Failed initial EC2 API limits update" error="timed out waiting for the condition"
  #      level=fatal msg="Unable to start eni allocator"
  #    → operator CrashLoop → 에이전트가 `required=2 available=0` 으로 멈춤 → **파드 IP 0개**.
  #
  #    🔴 원인이 지연도 권한도 아니다. 같은 SA 로 띄운 검사 파드에서 실측:
  #       STS AssumeRoleWithWebIdentity **0.61초** ✅ · `DescribeInstanceTypes` 250종 **1.55초** ✅
  #       (5초 예산에 충분하다 ⇒ 지연 가설 기각 · IRSA 는 정상 동작 확인)
  #    차이는 **리전 변수 하나**였다. operator 파드에는 `AWS_REGION` 이 없고
  #    `AWS_DEFAULT_REGION` 은 차트가 **없는 optional 시크릿(`cilium-aws`)** 을 가리켜 런타임에 비어 있다.
  #    🔴 그리고 그 *선언이 존재하기 때문에* EKS 웹훅이 리전 주입을 **건너뛴다** —
  #      즉 "차트가 자리를 잡아 놓아서 웹훅이 채워 주지 못하는" 구조다.
  #      `AWS_STS_REGIONAL_ENDPOINTS=regional` 인데 리전이 없으면 STS 엔드포인트를 만들 수 없고,
  #      자격증명 해석이 실패해 5초 폴링이 그대로 타임아웃한다.
  #    ⚠️ IRSA 이전에는 이 문제가 **드러나지 않았다** — IMDS 자격증명 경로에서는 리전도 IMDS 로
  #       발견되기 때문이다(그래서 그때는 403 이라는 *응답*을 받았다). 즉 #14 를 고치자 #15 가 드러났다.
  #    🔴 **`AWS_DEFAULT_REGION` 을 여기 같이 넣으면 안 된다** — 차트가 이미 그 이름을
  #      (없는 시크릿 참조로) 선언하고 있어서 env 리스트에 **같은 이름이 둘**이 되고,
  #      쿠버네티스 전략적 병합 패치가 이를 화해시키지 못한다(2026-08-13 실측):
  #        Error: UPGRADE FAILED: failed to create patch: The order in patch list … doesn't
  #        match $setElementOrder list
  #      ⇒ 차트의 선언이 **웹훅의 주입도 막고 같은 이름의 덮어쓰기도 막는** 구조라,
  #        `AWS_REGION`(AWS SDK 가 `AWS_DEFAULT_REGION` 보다 **먼저** 보는 변수)만 넣는 것이
  #        유일하게 통하는 방법이다.
  extraEnv:
    - name: AWS_REGION
      value: "{{ eks_region }}"

# 🟡 ENI 가비지 컬렉션 범위 (2026-08-13 실행 경고에서 잡음)
#    미설정이면 operator 가 이렇게 경고한다:
#      "Unable to detect EKS cluster name for ENI garbage collection. This operator instance
#       may clean up dangling ENIs from other Cilium clusters."
#    🔴 계정에 Cilium 클러스터가 하나뿐인 지금은 무해하지만, 둘째가 생기면 **남의 ENI 를 지울 수 있다.**
#    지금(빈 클러스터)이 바꿀 수 있는 유일한 시점이다 — 나중에 바꾸면 노드 신원이 흔들린다.
cluster:
  name: "{{ eks_cluster_name }}"

# ── IRSA (C-30) ───────────────────────────────────────────────────────────────
# 🔴 **키가 `serviceAccounts.operator` 다 — `operator.serviceAccount` 가 아니다.**
#    2026-08-13 실행에서 실측으로 잡았다(결함 #14). 처음에 후자로 썼는데
#    **helm 은 모르는 값을 조용히 무시한다** → 설치는 성공(`deployed`)하고 SA 에 어노테이션만 없다.
#    그 결과 operator 가 IRSA 대신 **노드 롤로** EC2 를 부르다 죽는다:
#      UnauthorizedOperation: … assumed-role/mp-eks-node/i-… is not authorized to perform:
#      ec2:DescribeNetworkInterfaces
#      level=fatal msg="Unable to start eni allocator"
#    ⇒ CrashLoopBackOff. 🔴 **파드가 hostNetwork 라 IMDS(hop 1)에 닿기 때문에** 자격증명이
#      "없어서 실패" 하지 않고 **노드 롤로 조용히 대체**된다 — 그래서 증상이 권한 에러로 나온다.
#      (`eks_nodegroup.tf` 의 "hop limit 1 로 파드가 IMDS 에 닿지 못한다" 는 **hostNetwork 파드에는
#       적용되지 않는다** — 그 주석의 전제가 여기선 성립하지 않는다.)
# 🟢 아래 검증 태스크(`tasks/main.yml`)가 SA 어노테이션을 실제로 확인한다 —
#    "helm 이 성공했다" 를 성공으로 읽지 않기 위해서다.
serviceAccounts:
  operator:
    annotations:
      eks.amazonaws.com/role-arn: "{{ irsa_cilium_operator }}"

# Hubble — 온프렘과 같은 이유로 켠다(유입 경로 진단이 여기서만 보인다).
hubble:
  enabled: true
  relay:
    enabled: true
