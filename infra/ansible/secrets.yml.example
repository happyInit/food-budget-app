---
# 이 파일을 secrets.yml 로 복사 후 값 채우기 (secrets.yml 은 .gitignore 됨).
# Harbor admin 비번은 8자+ 대/소문자+숫자 필수.
harbor_admin_password: "CHANGE_ME_Aa1!"
harbor_db_password: "CHANGE_ME_dbAa1!"
tfstate_db_password: "CHANGE_ME_tfAa1!"
# 앱 OLTP DB(fbapp/foodbudget) 비번 — tfstate 와 같은 PG 인스턴스, DB만 분리
app_db_password: "CHANGE_ME_appAa1!"
# PGSync 복제 롤(pgsync) 비번 — PG→ES 색인 동기화 (design.md §330). REPLICATION 롤
pgsync_db_password: "CHANGE_ME_pgsyncAa1!"
# GitHub PAT (fine-grained: 해당 레포 + Administration:Read/write)
github_runner_pat: "CHANGE_ME_github_pat_..."
# Alertmanager → Slack Incoming Webhook URL
slack_webhook_url: "CHANGE_ME_https://hooks.slack.com/services/..."
# MinIO 루트 비밀번호 (K8s) — 8자 이상
minio_root_password: "CHANGE_ME_minioAa1!"
# in-cluster Grafana 관리자 비번 — 8자 이상
grafana_admin_password: "CHANGE_ME_grafAa1!"
# ArgoCD → config 레포 읽기 전용 배포키(ssh-keygen -t ed25519 로 생성 후 GitHub 배포키 등록)
argocd_repo_ssh_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  CHANGE_ME
  -----END OPENSSH PRIVATE KEY-----
# Cloudflare Tunnel (cloudflared 롤, 호스트 C CI webhook) — 터널 자격증명(TunnelSecret 포함).
#   값 = 호스트 C 의 ~/.cloudflared/<UUID>.json 파일 내용 그대로(한 줄 JSON).
#   tunnel_id(비밀 아님)는 group_vars/ci.yml 의 cloudflared_tunnel_id.
cloudflared_tunnel_credentials: 'CHANGE_ME_{"AccountTag":"...","TunnelSecret":"...","TunnelID":"..."}'
# ArgoCD GitHub 웹훅(즉시 CD, k8s_argocd 롤) — 기본 비활성. 켜는 법 = roles/k8s_argocd/defaults/main.yml.
#   github_secret = GitHub 웹훅 서명 검증용 공유 시크릿(openssl rand -hex 20 로 생성).
argocd_webhook_github_secret: "CHANGE_ME_openssl_rand_hex_20"
#   tunnel_credentials = in-cluster 터널(mp-argocd)의 <UUID>.json 내용 그대로(한 줄 JSON).
#     tunnel_id(비밀 아님)는 group_vars/k8s_nodes.yml 의 argocd_webhook_tunnel_id.
argocd_webhook_tunnel_credentials: 'CHANGE_ME_{"AccountTag":"...","TunnelSecret":"...","TunnelID":"..."}'
# 호스트 레벨 백업(etcd·Harbor·Jenkins)의 S3 자격증명 — 컴포넌트별 전용 버킷
#   (mp-etcd-backup-ap2 · mp-harbor-backup-ap2 · mp-jenkins-backup-ap2). 자격증명은 셋 공유.
#   PG barman 이 쓰는 IAM 유저(mp-backup) 키를 재사용하되, 정책이 세 버킷을 커버해야 한다
#   (s3:PutObject/GetObject/ListBucket/DeleteObject). 버킷·리전은 각 role defaults(<role>_backup_s3_bucket).
backup_s3_access_key: "CHANGE_ME_AKIA..."
backup_s3_secret_key: "CHANGE_ME_..."
