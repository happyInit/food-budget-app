# 이 파일을 backend.conf 로 복사해서 쓴다 (backend.conf 는 .gitignore).
# 사용:  terraform init -backend-config=backend.conf
# 자격증명은 conf 가 아니라 ~/.aws 프로필이 담당 — 파일 자체엔 비밀이 없다.
bucket       = "mp-backup-ap2"
key          = "tfstate/aws-crawl.tfstate"
region       = "ap-northeast-2"
profile      = "mp-backup"
use_lockfile = true
