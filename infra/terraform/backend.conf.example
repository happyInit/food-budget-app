# 이 파일을 backend.conf 로 복사해서 쓴다 (backend.conf 는 .gitignore).
# 사용:  terraform init -backend-config=backend.conf
# 자격증명은 conf 가 아니라 ~/.aws 프로필(mp-backup)이 담당 — 파일 자체엔 비밀 없음.
# (구 PG 백엔드는 2026-07-29 S3 로 이관 — 근거는 backend.tf 주석)
bucket       = "mp-backup-ap2"
key          = "tfstate/proxmox.tfstate"
region       = "ap-northeast-2"
profile      = "mp-backup"
use_lockfile = true
