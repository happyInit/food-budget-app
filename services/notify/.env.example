PGHOST=localhost
PGPORT=5432
PGDATABASE=foodbudget
PGUSER=fbapp
PGPASSWORD=

# ⚠️ account와 **동일한** 시크릿이어야 access JWT 서명을 검증할 수 있다.
# 🔴 필수 — 코드 기본값(폴백)이 없다. 비었거나 32자 미만이면 **기동 실패**(체크리스트 0-12).
#    생성: `openssl rand -base64 48`
JWT_SECRET=
JWT_ALG=HS256

# 공통 구조화 로그
ENVIRONMENT=development
LOG_LEVEL=INFO
