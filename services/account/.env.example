PGHOST=192.168.0.8
PGPORT=5432
PGDATABASE=foodbudget
PGUSER=fbapp
PGPASSWORD=

# ⚠️ 프로덕션에선 반드시 강한 랜덤값(≥32바이트)으로 교체 — 예: `openssl rand -base64 48`
#    (코드/여기 기본값은 개발용 placeholder라 PyJWT가 짧은 키 경고를 냄)
JWT_SECRET=dev-insecure-change-me
JWT_ALG=HS256
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14

# 공통 구조화 로그
ENVIRONMENT=development
LOG_LEVEL=INFO
