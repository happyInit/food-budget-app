PGHOST=localhost
PGPORT=5432
PGDATABASE=foodbudget
PGUSER=fbapp
PGPASSWORD=

# 🔴 필수 — 코드 기본값(폴백)이 없다. 비어 있으면 서비스가 **기동에 실패**한다(체크리스트 0-12).
#    32자 미만이거나 placeholder(dev-insecure-change-me 등)여도 기동을 막는다.
#    생성: `openssl rand -base64 48`   · 인증 쓰는 6개 서비스가 **같은 값**이어야 토큰이 상호검증된다.
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14

# 소셜 로그인 OAuth — 값은 각 provider 콘솔에서 발급(카카오 REST API 키·구글 클라이언트 ID/시크릿).
#   ⚠️ *_CLIENT_SECRET 은 비밀 → .env 에만 넣고 커밋 금지. *_REDIRECT_URI 는 provider 콘솔 등록값과 정확히 일치.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://app.mealbong.cloud/auth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.mealbong.cloud/auth/google/callback

# 공통 구조화 로그
ENVIRONMENT=development
LOG_LEVEL=INFO
