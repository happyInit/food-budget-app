PGHOST=localhost
PGPORT=5432
PGDATABASE=foodbudget
PGUSER=fbapp
PGPASSWORD=

# ⚠️ 프로덕션에선 반드시 강한 랜덤값(≥32바이트)으로 교체 — 예: `openssl rand -base64 48`
#    (코드/여기 기본값은 개발용 placeholder라 PyJWT가 짧은 키 경고를 냄)
JWT_SECRET=dev-insecure-change-me
JWT_ALG=HS256
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14

# 소셜 로그인 OAuth — 값은 각 provider 콘솔에서 발급(카카오 REST API 키·구글 클라이언트 ID/시크릿).
#   ⚠️ *_CLIENT_SECRET 은 비밀 → .env 에만 넣고 커밋 금지. *_REDIRECT_URI 는 provider 콘솔 등록값과 정확히 일치.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://app.mealbong.cloud/auth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.mealbong.cloud/auth/google/callback

# 공통 구조화 로그
ENVIRONMENT=development
LOG_LEVEL=INFO
