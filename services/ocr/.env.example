# OCR 서비스 환경변수 (services/chat/.env.example 컨벤션)
# ⚠️ 실제 .env는 커밋 금지(.gitignore). 아래는 키만 표기하는 예시.

OCR_BACKEND=vision

# Gemini Vision (유료예외 — 챗봇과 **별도 키**, 비용 서비스별 구분: docs/ocr-implementation.md §2)
GEMINI_API_KEY=
# ⚠️ **`-latest` 별칭 금지.** 구글이 별칭이 가리키는 빌드를 바꾸면 thinking_config 가 거부돼
#    OCR 이 전량 400 실패한다 — 실제 사고 이력(PR #272). 반드시 버전을 핀한다.
#    (여기 있던 gemini-flash-latest 는 별칭인 데다 lite 도 아니라 단가가 몇 배였다.)
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_S=20

# ── Vertex AI 전환(선택) — docs/gcp-migration-plan.md ─────────────────────────
# 기본 api_key. vertex 로 바꾸면 팀 GCP 로 붙는다. 되돌리기는 이 값 하나만 api_key 로.
#   GCP_LOCATION 은 기본값 없음 — 리전이 데이터 레지던시를 결정하므로 조용히 붙으면 안 된다.
GENAI_BACKEND=api_key            # api_key | vertex
GCP_PROJECT_ID=                  # 예: mealplanning-503911
# ✅ global = 팀 승인 결정(2026-07-30). 영수증 이미지의 국외 처리를 수용한다.
#    레지던시 포기가 아니라 flash-lite 가 리전 엔드포인트에 **미배치**라 선택지가 없었다
#    (서울·도쿄 전부 404 실측). 상세·재검토 트리거 = docs/gcp-migration-plan.md §7-1
GCP_LOCATION=                    # 예: global
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json   # vertex 일 때만. 키는 레포에 넣지 말 것

# PG (item_master NER 조회 등 향후용 — ocr_receipt 저장은 백엔드 담당)
PGHOST=192.168.0.8
PGPORT=5432
PGDATABASE=foodbudget
PGUSER=fbapp
PGPASSWORD=
