PGHOST=localhost
PGPORT=5432
PGDATABASE=foodbudget
PGUSER=fbapp
PGPASSWORD=

# ⚠️ account 서비스와 **동일한** JWT_SECRET/JWT_ALG 여야 account 발급 토큰을 검증할 수 있다.
#    프로덕션에선 강한 랜덤값(≥32바이트)으로 교체 — 예: `openssl rand -base64 48`
JWT_SECRET=dev-insecure-change-me
JWT_ALG=HS256
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14

# 공통 구조화 로그
ENVIRONMENT=development
LOG_LEVEL=INFO
