PGHOST=192.168.0.8
PGPORT=5432
PGDATABASE=foodbudget
PGUSER=fbapp
PGPASSWORD=

# ⚠️ account 와 반드시 같은 값 — account가 발급한 JWT를 mealplan이 검증만 한다(재발급 X).
#    프로덕션에선 강한 랜덤값(≥32바이트): `openssl rand -base64 48`
JWT_SECRET=dev-insecure-change-me
JWT_ALG=HS256
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14

# 크로스서비스 seam(어댑터 base URL) — schema-per-service: DB 조인 금지 → API 호출.
#   예산 = account User API(#9), 재고·안버린재료 = pantry API. HTTP 배선은 TODO.
ACCOUNT_BASE_URL=http://account:8004
PANTRY_BASE_URL=http://pantry:8005
