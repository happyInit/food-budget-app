# Chat Service 환경변수 템플릿 — 복사해서 `.env`로 (gitignore됨, 커밋 금지).
# 값 미지정 시 app/config.py 기본값 사용.

# 관측 공통 필드
ENVIRONMENT=development
LOG_LEVEL=INFO

# 데이터 티어 — pipelines/ingest 와 동일 컨벤션. 값은 로컬 개발 기준(운영은 app-common 주입)
PGHOST=localhost
PGPORT=5432
PGDATABASE=foodbudget
PGUSER=fbapp
PGPASSWORD=
ESHOST=localhost
ESPORT=9200
REDISHOST=localhost
REDISPORT=6379

# ── 생성 백엔드 ──
# template = 무료·승인 불필요 (기본, 2026-07-13 팀 확정)
# gemini   = opt-in 실험용. ⚠️ 프로덕션 활성은 AGENTS.md 유료예외 재승인 필요(chat-assistant-ai.md §3)
GENERATOR_BACKEND=template

# GENERATOR_BACKEND=gemini 일 때만 필요:
# GEMINI_API_KEY=              # 개인/프로젝트 키 (커밋 금지)
# GEMINI_MODEL=gemini-2.5-flash-lite   # 현재 사용가능한 flash-lite id로 조정
# 비용 최소화 레버(기본값 권장):
# GEMINI_REFINE_RECOMMEND_ONLY=true    # 가격·영양은 template 그대로, 레시피 추천만 다듬음
# GEMINI_CACHE_TTL_S=2592000           # 동일 근거 다듬기 결과 Redis 캐시(30일) → 재호출 0원
# GEMINI_MAX_OUTPUT_TOKENS=200
