  <diagram id="jdNH3JBh2jb0ACs80pAT" name="물리적 모델링">
    <mxGraphModel dx="2943" dy="1789" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&quot;data&quot;:&quot;erDiagram\n    %% food-budget-app 전체 ERD - draw.io Mermaid Import 전용\n    %% 실선(--): 실제 PostgreSQL FK / 점선(..): 서비스 간 logical reference\n\n    public_item_master {\n        bigserial item_id PK\n        text canonical_name UK\n        text category\n        text note\n        numeric density_g_per_ml\n    }\n    public_item_alias {\n        text alias PK\n        bigint item_id FK\n        text source\n    }\n    public_item_unit_weight {\n        bigint item_id PK,FK\n        text unit PK\n        numeric grams\n        text src\n    }\n    public_food_nutrition {\n        text food_cd PK\n        text food_name\n        numeric serving_g\n        numeric kcal\n        numeric carb_g\n        numeric protein_g\n        numeric fat_g\n        numeric sugar_g\n        numeric sodium_mg\n        bigint item_id FK\n        timestamptz fetched_at\n    }\n    public_shelf_life_ref {\n        bigserial id PK\n        text source\n        text food_category\n        text item_name\n        text storage\n        int days_min\n        int days_max\n        text note\n        bigint item_id FK\n        timestamptz fetched_at\n    }\n    public_recipe {\n        bigserial id PK\n        text source\n        text src_recipe_id\n        text name\n        text category\n        text cook_method\n        text cooking_time\n        text level_nm\n        numeric kcal\n        numeric carb_g\n        numeric protein_g\n        numeric fat_g\n        numeric sodium_mg\n        text serving\n        text image_url\n        timestamptz fetched_at\n    }\n    public_recipe_ingredient {\n        bigserial id PK\n        bigint recipe_id FK\n        int seq\n        text ingredient_name\n        text quantity\n        text ingredient_raw\n        text ner_status\n        bigint item_id FK\n    }\n    public_recipe_step {\n        bigserial id PK\n        bigint recipe_id FK\n        int step_no\n        text description\n        text image_url\n    }\n    public_price_item {\n        text item_cd PK\n        text item_name\n        bigint item_id FK\n    }\n    public_price_online_daily {\n        text item_cd PK,FK\n        date survey_date PK\n        numeric price_min\n        numeric price_med\n        numeric price_max\n        int obs_count\n        timestamptz fetched_at\n    }\n    public_crawl_raw {\n        bigserial id PK\n        text source\n        text kind\n        text src_key\n        jsonb payload\n        timestamptz crawled_at\n        timestamptz landed_at\n        timestamptz processed_at\n    }\n    public_retail_product {\n        bigserial id PK\n        text source\n        text product_id\n        text name\n        text name_norm\n        bigint item_id FK\n        numeric weight_g\n        numeric volume_ml\n        text category\n        text url\n        text image_url\n        text storage\n        text origin\n        text expiry_text\n        timestamptz first_seen\n        timestamptz last_seen\n    }\n    public_retail_price {\n        bigint retail_product_id PK,FK\n        timestamptz crawled_at PK\n        numeric price\n        numeric original_price\n        int discount_rate\n        text deal_type\n        timestamptz timedeal_end\n        numeric unit_price\n        text unit_basis\n        boolean is_sold_out\n    }\n\n    account_app_user {\n        bigserial id PK\n        text email UK\n        text password_hash\n        text nickname\n        text provider\n        text provider_uid\n        timestamptz created_at\n        timestamptz updated_at\n        boolean activity_consent\n        timestamptz consented_at\n    }\n    account_user_budget {\n        bigserial id PK\n        bigint user_id FK\n        date month\n        numeric amount\n        timestamptz created_at\n    }\n    account_user_excluded_item {\n        bigserial id PK\n        bigint user_id FK\n        bigint item_id FK\n        text name\n        timestamptz created_at\n    }\n\n    recipebook_bookmark {\n        bigserial id PK\n        bigint user_id\n        bigint recipe_id FK\n        timestamptz created_at\n    }\n    recipebook_user_recipe {\n        bigserial id PK\n        bigint user_id\n        text origin\n        text title\n        text source_url\n        text image_url\n        jsonb ingredients\n        jsonb steps\n        text cooking_time\n        text serving\n        text level_nm\n        boolean is_public\n        text share_token UK\n        timestamptz created_at\n    }\n    recipebook_shared_recipe {\n        bigserial id PK\n        bigint user_recipe_id FK,UK\n        bigint user_id\n        text title\n        text image_url\n        jsonb ingredients\n        jsonb steps\n        text source_url\n        text origin\n        text share_token UK\n        timestamptz published_at\n    }\n    recipebook_extract_job {\n        bigserial id PK\n        bigint user_id\n        text url\n        text status\n        jsonb result\n        timestamptz created_at\n    }\n\n    pantry_pantry_item {\n        bigserial id PK\n        bigint user_id\n        bigint item_id FK\n        text name\n        text quantity\n        text storage\n        date expire_at\n        text source\n        text status\n        timestamptz created_at\n        timestamptz closed_at\n    }\n    pantry_ocr_receipt {\n        bigserial id PK\n        bigint user_id\n        text status\n        text store\n        timestamptz purchased_at\n        numeric total_amount\n        timestamptz created_at\n    }\n    pantry_ocr_receipt_item {\n        bigserial id PK\n        bigint receipt_id FK\n        text raw_text\n        text name\n        bigint item_id FK\n        text quantity\n        numeric price\n        boolean is_food\n        boolean confirmed\n    }\n\n    mealplan_cart_item {\n        bigserial id PK\n        bigint user_id\n        bigint retail_product_id FK\n        bigint recipe_id FK\n        bigint item_id FK\n        text name\n        int qty\n        text quantity\n        timestamptz added_at\n    }\n    mealplan_expense {\n        bigserial id PK\n        bigint user_id\n        numeric amount\n        text category\n        date spent_on\n        text memo\n        text source\n        bigint receipt_id\n        timestamptz created_at\n    }\n\n    price_price_watch {\n        bigserial id PK\n        bigint user_id\n        bigint item_id FK\n        timestamptz created_at\n    }\n\n    notify_notification {\n        bigserial id PK\n        bigint user_id\n        text type\n        text title\n        text body\n        jsonb payload\n        boolean is_read\n        timestamptz created_at\n    }\n    notify_notification_setting {\n        bigint user_id PK\n        boolean low_price\n        boolean expiry\n        boolean hotdeal\n        boolean budget\n        timestamptz updated_at\n    }\n\n    chat_chat_message {\n        bigserial id PK\n        bigint user_id\n        uuid session_id\n        text role\n        text text\n        text intent\n        bigint[] item_ids\n        boolean unanswered\n        jsonb basis\n        timestamptz created_at\n    }\n\n    activity_user_event {\n        bigserial id PK\n        uuid event_id UK\n        bigint user_id\n        uuid session_id\n        text event_type\n        bigint recipe_id\n        bigint item_id\n        timestamptz occurred_at\n        jsonb context\n        timestamptz created_at\n    }\n    activity_recipe_impression {\n        bigserial id PK\n        uuid impression_id UK\n        bigint user_id\n        uuid session_id\n        timestamptz shown_at\n        bigint recipe_id\n        int rank\n        numeric rule_score\n        numeric score_stock\n        numeric score_expiry\n        numeric score_cost\n        jsonb request_ctx\n    }\n\n    activity_recipe_popularity {\n        bigint recipe_id PK\n        bigint add_cart_cnt\n        bigint view_cnt\n        timestamptz updated_at\n    }\n    activity_user_chat_pref {\n        bigint user_id PK\n        bigint[] liked_item_ids\n        bigint[] disliked_item_ids\n        real budget_sensitivity\n        timestamptz updated_at\n    }\n    public_retail_unit_price {\n        bigint id UK\n        text source\n        bigint item_id\n        text name\n        numeric weight_g\n        numeric price\n        text deal_type\n        timestamptz crawled_at\n        numeric won_per_100g\n        numeric won_per_piece\n        text piece_unit\n        numeric won_per_100ml\n    }\n    public_retail_item_price_compare {\n        bigint item_id\n        text canonical_name\n        text category\n        numeric kurly_100g\n        numeric oasis_100g\n        bigint kurly_n\n        bigint oasis_n\n        numeric kurly_100ml\n        numeric oasis_100ml\n        bigint kurly_ml_n\n        bigint oasis_ml_n\n    }\n    public_retail_item_piece_compare {\n        text canonical_name\n        text category\n        text piece_unit\n        numeric kurly_per_piece\n        numeric oasis_per_piece\n        bigint kurly_n\n        bigint oasis_n\n    }\n    %% 실제 물리 FK: 실선\n    public_item_master ||--o{ public_item_alias : has_alias\n    public_item_master ||--o{ public_item_unit_weight : has_unit_weight\n    public_item_master ||--o{ public_food_nutrition : maps_nutrition\n    public_item_master ||--o{ public_shelf_life_ref : maps_shelf_life\n    public_recipe ||--o{ public_recipe_ingredient : contains\n    public_item_master o|--o{ public_recipe_ingredient : normalizes\n    public_recipe ||--o{ public_recipe_step : has_steps\n    public_item_master o|--o{ public_price_item : maps_baseline_item\n    public_price_item ||--o{ public_price_online_daily : has_daily_price\n    public_item_master o|--o{ public_retail_product : normalizes_product\n    public_retail_product ||--o{ public_retail_price : has_snapshots\n\n    account_app_user ||--o{ account_user_budget : owns_budget\n    account_app_user ||--o{ account_user_excluded_item : excludes\n    public_item_master ||--o{ account_user_excluded_item : excluded_item\n\n    public_recipe ||--o{ recipebook_bookmark : bookmarked\n    recipebook_user_recipe ||--o| recipebook_shared_recipe : publishes\n\n    public_item_master o|--o{ pantry_pantry_item : anchors_inventory\n    pantry_ocr_receipt ||--o{ pantry_ocr_receipt_item : contains_lines\n    public_item_master o|--o{ pantry_ocr_receipt_item : anchors_ocr_line\n\n    public_retail_product o|--o{ mealplan_cart_item : selected_sku\n    public_recipe o|--o{ mealplan_cart_item : source_recipe\n    public_item_master o|--o{ mealplan_cart_item : cart_item_anchor\n\n    public_item_master ||--o{ price_price_watch : watched_item\n\n    %% cross-service logical reference: 점선 (DB FK는 없음)\n    account_app_user ||..o{ recipebook_bookmark : logical_owner\n    account_app_user ||..o{ recipebook_user_recipe : logical_owner\n    account_app_user ||..o{ recipebook_shared_recipe : logical_publisher\n    account_app_user ||..o{ recipebook_extract_job : logical_requester\n    account_app_user ||..o{ pantry_pantry_item : logical_owner\n    account_app_user ||..o{ pantry_ocr_receipt : logical_owner\n    account_app_user ||..o{ mealplan_cart_item : logical_owner\n    account_app_user ||..o{ mealplan_expense : logical_owner\n    pantry_ocr_receipt o|..o{ mealplan_expense : logical_receipt\n    account_app_user ||..o{ price_price_watch : logical_owner\n    account_app_user ||..o{ notify_notification : logical_recipient\n    account_app_user ||..o| notify_notification_setting : logical_setting\n    account_app_user o|..o{ chat_chat_message : consented_author\n    account_app_user ||..o{ activity_user_event : logical_actor\n    public_recipe o|..o{ activity_user_event : logical_event_recipe\n    public_item_master o|..o{ activity_user_event : logical_event_item\n    account_app_user ||..o{ activity_recipe_impression : logical_viewer\n    public_recipe ||..o{ activity_recipe_impression : logical_impression_recipe\n\n    public_recipe ||..o| activity_recipe_popularity : logical_recipe\n    account_app_user ||..o| activity_user_chat_pref : logical_user\n    public_retail_product ||..o{ public_retail_unit_price : derived\n    public_retail_price ||..o{ public_retail_unit_price : derived\n    public_retail_unit_price ||..o{ public_retail_item_price_compare : derived\n    public_retail_unit_price ||..o{ public_retail_item_piece_compare : derived\n    public_item_master ||..o{ public_retail_item_price_compare : derived\n    public_item_master ||..o{ public_retail_item_piece_compare : derived\n\n&quot;,&quot;config&quot;:null}" id="Uq_Fh0zjFFOPaC6Z1_N_-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
