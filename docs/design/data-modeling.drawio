        <mxCell id="codex-1nf-user-recipe" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;spacingBottom=8;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.2;fontColor=#111111;shadow=0;overflow=hidden;" value="&lt;div style=&#39;font-size:14px;font-weight:700;text-align:center;padding:4px 0 7px 0&#39;&gt;사용자 레시피 상세 1NF&lt;/div&gt;&lt;div style=&#39;border-top:1px solid #444;margin:0 0 6px 0&#39;&gt;&lt;/div&gt;&lt;div style=&#39;font-size:11px;line-height:1.5;text-align:left;white-space:nowrap&#39;&gt;&lt;b&gt;[PK]&lt;/b&gt; 사용자 레시피 ID &lt;span style=&#39;color:#666&#39;&gt;: 식별자&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-size:11px;line-height:1.5;text-align:left;white-space:nowrap&#39;&gt;&lt;b&gt;[PK]&lt;/b&gt; 재료 순번 &lt;span style=&#39;color:#666&#39;&gt;: 순번&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-size:11px;line-height:1.5;text-align:left;white-space:nowrap&#39;&gt;&lt;b&gt;[PK]&lt;/b&gt; 조리 순번 &lt;span style=&#39;color:#666&#39;&gt;: 순번&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-size:11px;line-height:1.5;text-align:left;white-space:nowrap&#39;&gt;&lt;b&gt;[LR]&lt;/b&gt; 사용자 ID &lt;span style=&#39;color:#666&#39;&gt;: 식별자&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-size:11px;line-height:1.5;text-align:left;white-space:nowrap&#39;&gt;제목 &lt;span style=&#39;color:#666&#39;&gt;: 문자열&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-size:11px;line-height:1.5;text-align:left;white-space:nowrap&#39;&gt;작성 출처 &lt;span style=&#39;color:#666&#39;&gt;: 코드&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-size:11px;line-height:1.5;text-align:left;white-space:nowrap&#39;&gt;조리 시간 &lt;span style=&#39;color:#666&#39;&gt;: 문자열&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-size:11px;line-height:1.5;text-align:left;white-space:nowrap&#39;&gt;인분 &lt;span style=&#39;color:#666&#39;&gt;: 문자열&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-size:11px;line-height:1.5;text-align:left;whit