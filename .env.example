# 앱/데이터파이프라인 환경변수 템플릿.
# 실제 값은 이 파일을 복사한 `.env`에 넣으세요 (.env 는 gitignore됨, 커밋 금지).
# 에이전트는 .env 값을 읽지/출력하지 않습니다.

# 배포 이미지 버전 태그 — data-pipeline·crawler-kurly 공통(compose 가 참조). CI env APP_VERSION 과 일치.
# 미설정 시 1.1.2(릴리스 핀). 최신 자동빌드를 원하면 IMAGE_TAG=latest. 릴리스마다 올림.
# IMAGE_TAG=1.1.2

# 공공데이터포털(data.go.kr) 일반 인증키 — 계정 단위, 승인된 모든 API 공용
# (온라인가격 15080757 등). "일반 인증키(Decoding)" 값을 넣으세요.
DATA_GO_KR_SERVICE_KEY=

# (후속) 식품안전나라 openapi.foodsafetykorea.go.kr keyId — COOKRCP01 등.
# data.go.kr 키와 별개 발급이라 나중에 필요.
# FOODSAFETY_API_KEY=

# (후속) 적재 대상 DB — 로컬 개발 기준 foodbudget. 비번은 여기 or infra/ansible/secrets.yml.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=foodbudget
# PGUSER=fbapp
# PGPASSWORD=

# (후속) Elasticsearch — 로컬 개발 기준, security off(내부망), 인증정보 없음.
# ESHOST=localhost
# ESPORT=9200

# (후속) 만개 레시피 크롤 상태 볼륨(호스트 경로) — poller-recipe resume/dedup 영속. 미설정 시 ./recipe-crawl-state.
# RECIPE_CRAWL_STATE_HOST=./recipe-crawl-state
