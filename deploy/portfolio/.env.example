# 밀플래닝 포트폴리오 스택 — 환경변수 예시
#
#   cp .env.example .env && chmod 600 .env && vi .env
#
# 🔴 .env 는 커밋하지 않는다 (.gitignore 확인). 실제 값은 이관 시 EKS 시크릿에서 추출한 것을 쓴다.

# ── 필수 3종 (없으면 compose 가 기동 자체를 거부한다) ─────────────────────────
PGPASSWORD=                       # 앱 DB 비밀번호. postgres 컨테이너 초기화와 앱 접속에 같이 쓰인다
JWT_SECRET=                       # 🔴 전 서비스가 같은 값이어야 토큰 상호검증이 된다
# Cloudflare Tunnel 은 토큰이 아니라 자격증명 파일을 쓴다 (라우팅은 cloudflared/config.yml).
#   cloudflared tunnel create mp-portfolio  →  ~/.cloudflared/<UUID>.json
#   그 파일을 deploy/portfolio/cloudflared/credentials.json 로 둔다 (커밋 금지).

# ── 기본값이 있어 비워도 되는 것 ─────────────────────────────────────────────
PGDATABASE=foodbudget
PGUSER=fbapp
JWT_ALG=HS256
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://app.mealbong.cloud
ES_INDEX=recipes_live             # 별칭. 실체 색인은 recipes_v2
ES_USER_INDEX=user_recipes_live

# ── 소셜 로그인 (백엔드용 · client_secret 은 비밀) ────────────────────────────
#    프론트의 공개 client_id 는 frontend/.env.production 에 이미 커밋돼 있어 빌드 시 자동 반영된다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 챗 어시스턴트 ────────────────────────────────────────────────────────────
#    template = 규칙 기반(무료, 기본) · gemini = LLM 생성(유료 API)
GENERATOR_BACKEND=template
CHAT_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MONTHLY_CAP_ENABLED=true          # gemini 를 켤 때 월 예산 초과 시 template 으로 자동 강등
MONTHLY_BUDGET_WON=7200

# ── OCR(영수증) · 영상 추출 — Google Cloud 자격증명 필요 ─────────────────────
#    둘 다 비워두면 해당 기능만 실패하고 나머지 서비스는 정상 동작한다.
GCP_SA_FILE=./secrets/gcp-sa.json # 서비스 계정 JSON 경로 (컨테이너에 :ro 로 마운트)
GCP_PROJECT_ID=
GCP_LOCATION=asia-northeast3
OCR_BACKEND=vision                # 지원값: vision · mock
GENAI_BACKEND=vertex
OCR_GEMINI_API_KEY=
OCR_GEMINI_MODEL=gemini-3.5-flash-lite
VIDEO_GENAI_BACKEND=vertex
VIDEO_GEMINI_API_KEY=
VIDEO_EXTRACT_MODEL=gemini-3.5-flash-lite
VIDEO_REFINE_ENABLED=false
