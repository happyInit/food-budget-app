# deploy/app/.env — 이 파일을 복사해 값 채우기: cp .env.example .env
# ⚠️ .env(실값)는 커밋 금지 — .gitignore 처리. 시크릿은 여기(.env)와 GH Actions Secrets 에만.

# ── 배포 프로필(어느 profile 서비스를 CI 자동배포에 포함할지) ──────────────────
#   docker compose 는 이 .env 의 COMPOSE_PROFILES 를 자동으로 읽는다 → CI deploy 잡의
#   `docker compose up -d` 가 지정된 프로필 서비스까지 함께 기동. 즉 여기에 프로필명을
#   추가하는 것만으로 profile 서비스(ranking·ocr)가 CI/CD 자동배포에 편입된다.
#   비우면 profile 없는 기본 서비스만 배포(현행). 개인화 활성: ranking 추가.
COMPOSE_PROFILES=                 # 예: ranking  (여러 개: ranking,ocr)
PGHOST=192.168.0.8
PGPORT=5432
PGDATABASE=foodbudget            # 프로덕션 앱 OLTP DB (dev clone: foodbudget_dev_* 아님)
PGUSER=fbapp
PGPASSWORD=                       # ← fbapp DB 비번 (필수)
JWT_SECRET=                       # ← 서비스 공통 시크릿 (7개 동일해야 토큰 상호검증) (필수)
JWT_ALG=HS256
ESHOST=192.168.0.8
ESPORT=9200
ES_INDEX=recipes                 # recipe 서빙 인덱스: recipes(batch 폴러) | recipes_pgsync(PGSync CDC 컷오버)
# chat 서비스 전용(나머지 7개는 미사용). 값 없으면 compose 기본(.8/6379/template/rule) 사용.
REDISHOST=192.168.0.8
REDISPORT=6379
GENERATOR_BACKEND=template       # template | gemini(유료 API — 팀 재승인 필요)
EXTRACTOR_BACKEND=rule           # rule | ner
# chat Gemini 생성 (#147) — GENERATOR_BACKEND=gemini 로 켤 때만. OCR GEMINI_API_KEY 와 **별도 키**(비용 격리).
CHAT_GEMINI_API_KEY=             # ← chat gemini 필수. 빈값+template(기본)이면 무해. GH Actions Secrets/.env 에만.
RATE_LIMIT_ENABLED=false         # true=유저/IP별 일일 상한 초과 시 무료 template 강등(비용 방어)
# 월 예산 상한(#155 cost-break) — Gemini prod 활성 시 켤 것(팀 문서가 이걸 비용가드로 명시).
MONTHLY_CAP_ENABLED=false        # true=월 누적 Gemini 비용이 예산 초과 시 template 자동 강등
MONTHLY_BUDGET_WON=7200          # 월 예산(원). Google 청구캡 8,000의 90%. 근거 docs/chat-monthly-cost-cap-analysis.md
# chat 계정연동·멀티턴 (#127·#125). 기본 OFF=현동작 유지. 활성 시 프론트 session_id 왕복이 멀티턴으로 동작.
ACCOUNT_INTEGRATION_ENABLED=false  # true=마이페이지 제외재료 ↔ 챗 비선호 양방향(JWT 소유자 스코프, 프론트가 자동 첨부)
ACCOUNT_BASE_URL=http://account:8004
MULTITURN_ENABLED=false            # true=Redis 세션 멀티턴(단기 TTL, 동의 무관). 켜면 세션 승계·"다른 추천은?" 동작
# ocr 서비스 전용(영수증 인식). vision=유료 Gemini(챗봇과 **별도 키** — 비용 격리), mock=키 없이 데모(#121 이후).
OCR_BACKEND=vision               # vision | mock
GEMINI_API_KEY=                  # ← OCR vision 필수. 빈값+vision 이면 ocr 컨테이너만 기동실패(스택 격리). GH Actions Secrets/.env 에만.
GEMINI_MODEL=gemini-flash-lite-latest   # 벤치마크 최적(성공률 92%·0.45원/장)
ENVIRONMENT=production
LOG_LEVEL=INFO
# OpenTelemetry → fb-monitoring Tempo OTLP gRPC. 초기 운영은 전체 수집.
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=192.168.0.11:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# Chat의 코드 기반 계측 설정.
OTEL_TRACES_SAMPLER_RATIO=1.0
# Chat 외 FastAPI 서비스의 opentelemetry-instrument 자동 계측 설정.
OTEL_TRACES_EXPORTER=otlp_proto_grpc
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=health,metrics
IMAGE_TAG=1.1.1                  # 배포 이미지 버전 태그 (CI env APP_VERSION 과 일치). 릴리스마다 올림.

# ── P1 개인화 랭킹 (profile: ranking) ─────────────────────────────────────
# ranking-serving(로드) ↔ ranking-retrain(저장)이 ranking-model 볼륨의 이 경로를 공유.
RANKING_MODEL_PATH=/models/ranker.pkl
RETRAIN_INTERVAL_SEC=86400       # 재학습 주기(초). 기본 일 1회.
RETRAIN_DAYS=90                  # 학습 스냅샷 창(최근 N일 activity).

# ── P1 개인화 랭킹 활성화 (mealplan) — 스키마·클릭스트림 준비 후 ON ──
IMPRESSION_LOG_ENABLED=false      # 추천 노출을 activity.recipe_impression에 로깅(학습데이터)
EVENT_PRODUCE_ENABLED=false       # ADD_CART를 Kafka events.user.activity로 발행(라벨)
RANKING_ML_ENABLED=false          # ML 재랭킹 호출(OFF/장애/콜드스타트→규칙순 폴백)
