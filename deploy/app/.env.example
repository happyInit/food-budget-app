# deploy/app/.env — 이 파일을 복사해 값 채우기: cp .env.example .env
# ⚠️ .env(실값)는 커밋 금지 — .gitignore 처리. 시크릿은 여기(.env)와 GH Actions Secrets 에만.
PGHOST=192.168.0.8
PGPORT=5432
PGDATABASE=foodbudget            # 프로덕션 앱 OLTP DB (dev clone: foodbudget_dev_* 아님)
PGUSER=fbapp
PGPASSWORD=                       # ← fbapp DB 비번 (필수)
JWT_SECRET=                       # ← 서비스 공통 시크릿 (7개 동일해야 토큰 상호검증) (필수)
JWT_ALG=HS256
ESHOST=192.168.0.8
ESPORT=9200
# IMAGE_TAG=latest               # compose pull 태그 (기본 latest; CI 는 서비스별 :latest 갱신)
